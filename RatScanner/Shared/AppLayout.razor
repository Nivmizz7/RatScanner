@inherits LayoutComponentBase
@layout MainLayout
@inject MenuVM MenuVM
@inject LocalizationService Localizer

<div class="app-shell">
    <header class="compact-bar">
        <button class="icon-button" aria-label="Open navigation" @onclick="OpenDrawer"><MudIcon Icon="@Icons.Material.Filled.Menu" /></button>
        <span>@Constants.Branding.Name</span>
    </header>
    <aside class="sidebar @(_drawerOpen ? "open" : null)" @onkeydown="HandleKey">
        <div class="product-identity">
            <img src="RatLogoMedium.png" alt="" />
            <strong>@Constants.Branding.Name</strong>
            <span>@Localizer["TarkovTrackerEdition"]</span>
            <small>v@(MenuVM.Version)</small>
        </div>
        <nav aria-label="Primary navigation">
            <NavLink href="/app" Match="NavLinkMatch.All"><MudIcon Icon="@Icons.Material.Filled.DocumentScanner" /> <span>Scan</span></NavLink>
            <NavLink href="/app/history"><MudIcon Icon="@Icons.Material.Filled.History" /> <span>History</span></NavLink>
            <NavLink href="/app/settings/general"><MudIcon Icon="@Icons.Material.Filled.Settings" /> <span>Settings</span></NavLink>
            <NavLink href="/app/credits"><MudIcon Icon="@Icons.Material.Filled.Info" /> <span>About</span></NavLink>
        </nav>
        <div class="sidebar-spacer"></div>
        <section class="scanner-card @(!IsScannerActive ? "paused" : null)" aria-label="Scanner status" aria-live="polite">
            <div><span class="status-dot" aria-hidden="true"></span><strong>@(IsScannerActive ? "Scanner active" : "Scanner paused")</strong></div>
            <span>@(IsScannerActive ? "Waiting for an item" : "Enable scanning in Settings")</span>
        </section>
        <footer><span>TarkovTracker.org Fork</span><a href="https://github.com/RatScanner/RatScanner" target="_blank" rel="noopener">Support the original project</a></footer>
    </aside>
    @if (_drawerOpen) { <button class="scrim" aria-label="Close navigation" @onclick="CloseDrawer"></button> }
    <main class="main-content">@Body</main>
</div>

@code {
    private bool _drawerOpen;
    private bool IsScannerActive => RatConfig.NameScan.Enable || RatConfig.IconScan.Enable;
    private void OpenDrawer() => _drawerOpen = true;
    private void CloseDrawer() => _drawerOpen = false;
    private void HandleKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseDrawer(); }
}
