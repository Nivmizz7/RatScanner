<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>True</UseWindowsForms>
		<ApplicationIcon>Resources\RatLogoSmall.ico</ApplicationIcon>
		<StartupObject>RatScanner.App</StartupObject>
		<Version>3.9.3</Version>
		<ImplicitUsings>disable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<RootNamespace>RatScanner</RootNamespace>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<nullable>Enable</nullable>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<!--
			Some IDE design-time hosts (or past EmitCompilerGeneratedFiles runs) can leave a
			stale GraphQlClient.cs under obj/generated/. If that tree is still compiled alongside
			the live source-generator output, every TarkovDev.GraphQL type becomes ambiguous.
			DefaultItemExcludes already drops most of obj/, but keep an explicit belt for this path.
		-->
		<DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\generated\**</DefaultItemExcludes>
		<!--
			GraphQlClientGenerator emits non-nullable reference properties (e.g. Id: string)
			without `required` / field initializers when DataClassMemberNullability=DefinedBySchema.
			Those members cannot be fixed in generated code. Suppress CS8618 only for this
			project (hosts the generator). RatEye/tests keep full analysis. Hand-written
			CS8618 is still fixed in source (e.g. Blazor [Parameter] uses `= default!;`).
			IDE/pathless generated trees are covered by .globalconfig + .editorconfig override.
		-->
		<NoWarn>$(NoWarn);CS8618</NoWarn>
		<GraphQlClientGenerator_ServiceUrl>https://api.tarkov.dev/graphql</GraphQlClientGenerator_ServiceUrl>
		<GraphQlClientGenerator_Namespace>$(RootNamespace).TarkovDev.GraphQL</GraphQlClientGenerator_Namespace>
		<GraphQlClientGenerator_IdTypeMapping>String</GraphQlClientGenerator_IdTypeMapping>
		<GraphQlClientGenerator_DataClassMemberNullability>DefinedBySchema</GraphQlClientGenerator_DataClassMemberNullability>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<DefineConstants>TRACE</DefineConstants>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Resources\iconMods.png" />
		<Resource Include="Resources\settings.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DeepCloner" Version="0.10.4" />
		<PackageReference Include="GraphQlClientGenerator" Version="0.9.22" IncludeAssets="analyzers" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.71" />
		<PackageReference Include="MudBlazor" Version="6.10.0" />
		<PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.421302">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.7" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="RatStash" Version="6.0.0" />
		<PackageReference Include="SingleInstanceCore" Version="2.2.2" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="GraphQlClientGenerator_ServiceUrl" />
		<CompilerVisibleProperty Include="GraphQlClientGenerator_Namespace" />
		<CompilerVisibleProperty Include="GraphQlClientGenerator_IdTypeMapping" />
		<CompilerVisibleProperty Include="GraphQlClientGenerator_DataClassMemberNullability" />
		<!-- Unfinished migration draft (not .cs) so IDE/MSBuild don't load it alongside GraphQL-generated models. -->
		<None Include="TarkovDev\Models.cs.wip" />
	</ItemGroup>

	<ItemGroup>
		<!-- In-repo image processing library (vendored RatEye; do not restore NuGet RatEye). -->
		<ProjectReference Include="..\RatEye\RatEye.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Data\maps.json" />
		<Content Remove="wwwroot\fonts\bender.bold.otf" />
		<Content Remove="wwwroot\fonts\bender.regular.otf" />
		<Content Remove="wwwroot\interactableOverlay.html" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Data\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\RatLogoMedium.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<Content Update="_Imports.razor">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>
</Project>
