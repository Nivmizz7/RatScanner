<Window x:Class="RatScanner.PageSwitcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Rat Scanner"
        AllowsTransparency="True"
        Background="#121212"
        ResizeMode="CanResize"
        WindowStyle="None"
        mc:Ignorable="d">
	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="48"
		              CornerRadius="0"
		              GlassFrameThickness="0"
		              ResizeBorderThickness="7"
		              UseAeroCaptionButtons="False" />
	</WindowChrome.WindowChrome>
	<Grid x:Name="WindowRoot"
	      Margin="7">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid x:Name="TitleBar"
		      Grid.Row="0"
		      Height="48"
		      Background="{DynamicResource NativeTitleBarBackgroundBrush}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- Navigation toggle -->
			<Button x:Name="NavToggleButton"
			        Grid.Column="0"
			        Width="40"
			        Height="40"
			        Margin="4,0,0,0"
			        VerticalAlignment="Center"
			        Click="OnToggleSidebar"
			        FocusVisualStyle="{StaticResource FocusVisual}"
			        IsTabStop="True"
			        Style="{DynamicResource TitleBarButtonStyle}"
			        WindowChrome.IsHitTestVisibleInChrome="True">
				<Path x:Name="NavToggleIcon"
				      Width="16"
				      Height="16"
				      Stretch="Uniform"
				      SnapsToDevicePixels="True"
				      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
				      StrokeThickness="1.5" />
			</Button>

			<!-- App identity -->
			<StackPanel Grid.Column="1"
			            Margin="6,0,0,0"
			            Orientation="Horizontal">
				<Image Width="20"
				       Height="20"
				       Margin="0,0,8,0"
				       RenderOptions.BitmapScalingMode="HighQuality"
				       Source="/Resources/RatLogoMedium.png" />

				<TextBlock VerticalAlignment="Center"
				           FontSize="12"
				           Text="Rat Scanner">
					<TextBlock.Style>
						<Style TargetType="{x:Type TextBlock}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
									Value="True">
									<Setter Property="Foreground"
									        Value="{DynamicResource NativeTitleBarForegroundBrush}" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
									Value="False">
									<Setter Property="Foreground"
									        Value="{DynamicResource NativeTitleBarInactiveForegroundBrush}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>

			<!-- Caption buttons -->
			<StackPanel Grid.Column="3"
			            Orientation="Horizontal">
				<Button x:Name="MinimizeButton"
				        Width="46"
				        Click="OnTitleBarMinimize"
				        Style="{DynamicResource TitleBarButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path Width="10"
					      Height="10"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1"
					      Data="M 4,17 H 20" />
				</Button>

				<Button x:Name="MaximizeRestoreButton"
				        Width="46"
				        Click="OnTitleBarMaximizeRestore"
				        Style="{DynamicResource TitleBarButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path x:Name="MaximizeRestoreIcon"
					      Width="10"
					      Height="10"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1" />
				</Button>

				<Button x:Name="CloseButton"
				        Width="46"
				        Click="OnTitleBarClose"
				        Style="{DynamicResource TitleBarCloseButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path Width="10"
					      Height="10"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1"
					      Data="M 4,4 L 20,20 M 4,20 L 20,4" />
				</Button>
			</StackPanel>
		</Grid>

		<ContentControl x:Name="ContentControl"
		                Grid.Row="1" />
	</Grid>
</Window>
