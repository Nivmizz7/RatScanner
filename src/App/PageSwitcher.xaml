<Window x:Class="RatScanner.PageSwitcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Rat Scanner"
        AllowsTransparency="True"
        Background="#111516"
        ResizeMode="CanResize"
        WindowStyle="None"
        mc:Ignorable="d">
	<!-- ResizeBorderThickness is the invisible resize hit target (~7px) and must not
	     shrink with the visible frame; the visible edge is the 1px WindowRoot margin. -->
	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="36"
		              CornerRadius="0"
		              GlassFrameThickness="0"
		              ResizeBorderThickness="7"
		              UseAeroCaptionButtons="False" />
	</WindowChrome.WindowChrome>
	<Grid x:Name="WindowRoot"
	      Margin="1">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid x:Name="TitleBar"
		      Grid.Row="0"
		      Height="36"
		      Background="{DynamicResource NativeTitleBarBackgroundBrush}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- Navigation toggle -->
			<Button x:Name="NavToggleButton"
			        Grid.Column="0"
			        Width="30"
			        Height="30"
			        Margin="3,0,0,0"
			        VerticalAlignment="Center"
			        Click="OnToggleSidebar"
			        FocusVisualStyle="{StaticResource FocusVisual}"
			        IsTabStop="True"
			        Style="{DynamicResource TitleBarButtonStyle}"
			        WindowChrome.IsHitTestVisibleInChrome="True">
				<Path x:Name="NavToggleIcon"
				      Width="14"
				      Height="14"
				      Stretch="Uniform"
				      SnapsToDevicePixels="True"
				      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
				      StrokeThickness="1.4" />
			</Button>

			<!-- App identity: logo + name + version share one baseline -->
			<StackPanel Grid.Column="1"
			            Margin="8,0,0,0"
			            VerticalAlignment="Center"
			            Orientation="Horizontal">
				<Image Width="16"
				       Height="16"
				       Margin="0,0,7,0"
				       RenderOptions.BitmapScalingMode="HighQuality"
				       Source="/Resources/RatLogoMedium.png" />

				<TextBlock x:Name="BrandTextBlock"
				           VerticalAlignment="Center"
				           FontSize="12.5"
				           FontWeight="SemiBold">
					<Run x:Name="BrandNameRun" />
					<Run x:Name="BrandVersionRun"
					     BaselineAlignment="Baseline"
					     FontSize="10.5"
					     FontWeight="Regular"
					     Foreground="{DynamicResource NativeTitleBarVersionBrush}" />
					<TextBlock.Style>
						<Style TargetType="{x:Type TextBlock}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
									Value="True">
									<Setter Property="Foreground"
									        Value="{DynamicResource NativeTitleBarForegroundBrush}" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Path=IsActive, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
									Value="False">
									<Setter Property="Foreground"
									        Value="{DynamicResource NativeTitleBarInactiveForegroundBrush}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>

			<!-- Caption buttons -->
			<StackPanel Grid.Column="3"
			            Margin="0,0,3,0"
			            Orientation="Horizontal">
				<Button x:Name="MinimalUIButton"
				        Width="30"
				        Height="30"
				        Margin="1,0"
				        VerticalAlignment="Center"
				        Click="OnTitleBarMinimal"
				        FocusVisualStyle="{StaticResource FocusVisual}"
				        IsTabStop="True"
				        Style="{DynamicResource TitleBarButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path x:Name="MinimalUIIcon"
					      Width="12"
					      Height="12"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1.25" />
				</Button>

				<Rectangle Width="1"
				           Height="14"
				           Margin="3,0"
				           VerticalAlignment="Center"
				           Fill="{DynamicResource NativeTitleBarInactiveForegroundBrush}"
				           Opacity="0.3" />

				<Button x:Name="MinimizeButton"
				        Width="30"
				        Height="30"
				        Margin="1,0"
				        VerticalAlignment="Center"
				        Click="OnTitleBarMinimize"
				        FocusVisualStyle="{StaticResource FocusVisual}"
				        IsTabStop="True"
				        Style="{DynamicResource TitleBarButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path Width="12"
					      Height="12"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1.25"
					      Data="M 5,15.5 H 19" />
				</Button>

				<Button x:Name="MaxRestoreButton"
				        Width="30"
				        Height="30"
				        Margin="1,0"
				        VerticalAlignment="Center"
				        Click="OnTitleBarMaxRestore"
				        FocusVisualStyle="{StaticResource FocusVisual}"
				        IsTabStop="True"
				        Style="{DynamicResource TitleBarButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path x:Name="MaxRestoreIcon"
					      Width="12"
					      Height="12"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1.25"
					      Data="M 6,6 H 18 V 18 H 6 Z" />
				</Button>

				<Button x:Name="CloseButton"
				        Width="30"
				        Height="30"
				        Margin="1,0"
				        VerticalAlignment="Center"
				        Click="OnTitleBarClose"
				        FocusVisualStyle="{StaticResource FocusVisual}"
				        IsTabStop="True"
				        Style="{DynamicResource TitleBarCloseButtonStyle}"
				        WindowChrome.IsHitTestVisibleInChrome="True">
					<Path Width="12"
					      Height="12"
					      Stretch="Uniform"
					      SnapsToDevicePixels="True"
					      Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"
					      StrokeThickness="1.25"
					      Data="M 7,7 L 17,17 M 7,17 L 17,7" />
				</Button>
			</StackPanel>

			<!-- Subtle bottom divider separating chrome from content -->
			<Border Grid.Column="0"
			        Grid.ColumnSpan="4"
			        VerticalAlignment="Bottom"
			        Height="1"
			        Background="{DynamicResource NativeTitleBarControlBorderBrush}" />
		</Grid>

		<ContentControl x:Name="ContentControl"
		                Grid.Row="1" />
	</Grid>
</Window>
