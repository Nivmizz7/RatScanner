<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>True</UseWindowsForms>
		<ApplicationIcon>Resources\RatLogoSmall.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<StartupObject>RatScanner.Program</StartupObject>
		<!--
		  TarkovTracker Edition version line (independent of upstream RatScanner).
		  Upstream historically used 3.x (e.g. 3.9.3). This fork starts at 4.0.0 so
		  GitHub issues, logs, UA strings, and release tags are immediately distinguishable.
		  Bump Version here for every release; tags should match as vMAJOR.MINOR.PATCH.
		-->
		<Version>4.0.0</Version>
		<Product>RatScanner TarkovTracker Edition</Product>
		<AssemblyTitle>RatScanner TarkovTracker Edition</AssemblyTitle>
		<Company>TarkovTracker.org</Company>
		<Authors>TarkovTracker.org</Authors>
		<Description>TarkovTracker Edition of RatScanner — Escape from Tarkov item scanner maintained by TarkovTracker.org</Description>
		<Copyright>Copyright © TarkovTracker.org; original work by Moritz / Blightbuster</Copyright>
		<ImplicitUsings>disable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<RootNamespace>RatScanner</RootNamespace>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<nullable>Enable</nullable>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<!-- Exclude stale compiler-generated files left by IDE design-time builds. -->
		<!-- Exclude Data (thousands of icons) from item defaults / dotnet-watch so the file watcher is not flooded. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\generated\**;$(MSBuildProjectDirectory)\Data\**</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<DefineConstants>TRACE</DefineConstants>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- Bulk catalog/tasks/hideout/maps come from json.tarkov.dev (no GraphQL generator). -->
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.71" />
		<PackageReference Include="MudBlazor" Version="6.10.0" />
		<PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.9" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="RatStash" Version="6.0.0" />
		<PackageReference Include="SingleInstanceCore" Version="2.2.2" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- In-repo scan engine (vendored RatEye sources under src/ScanEngine; do not restore NuGet RatEye). -->
		<ProjectReference Include="..\ScanEngine\RatEye.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
		<!-- ELv2: anyone who receives a copy must also receive the license terms. -->
		<None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Data\maps.json" />
		<Content Remove="wwwroot\interactableOverlay.html" />
	</ItemGroup>

	<ItemGroup>
		<!-- Explicit include so Data is still copied to bin/publish after DefaultItemExcludes removed it. -->
		<!-- Watch=false: icon dumps must not restart the dev loop. -->
		<Content Include="Data\**" Watch="false">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\RatLogoMedium.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<Content Update="_Imports.razor">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>
</Project>
