<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>True</UseWindowsForms>
		<ApplicationIcon>Resources\RatLogoSmall.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<StartupObject>RatScanner.Program</StartupObject>
		<Version>3.9.3</Version>
		<ImplicitUsings>disable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<RootNamespace>RatScanner</RootNamespace>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<nullable>Enable</nullable>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<!-- Exclude stale compiler-generated files left by IDE design-time builds. -->
		<!-- Exclude Data (thousands of icons) from item defaults / dotnet-watch so the file watcher is not flooded. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\generated\**;$(MSBuildProjectDirectory)\Data\**</DefaultItemExcludes>
		<GraphQlClientGenerator_Namespace>$(RootNamespace).TarkovDev.GraphQL</GraphQlClientGenerator_Namespace>
		<GraphQlClientGenerator_IdTypeMapping>String</GraphQlClientGenerator_IdTypeMapping>
		<GraphQlClientGenerator_DataClassMemberNullability>DefinedBySchema</GraphQlClientGenerator_DataClassMemberNullability>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<DefineConstants>TRACE</DefineConstants>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GraphQlClientGenerator" Version="0.9.31" IncludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.71" />
		<PackageReference Include="MudBlazor" Version="6.10.0" />
		<PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.9" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="RatStash" Version="6.0.0" />
		<PackageReference Include="SingleInstanceCore" Version="2.2.2" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="GraphQlClientGenerator_Namespace" />
		<CompilerVisibleProperty Include="GraphQlClientGenerator_IdTypeMapping" />
		<CompilerVisibleProperty Include="GraphQlClientGenerator_DataClassMemberNullability" />
	</ItemGroup>

	<ItemGroup>
		<!-- Keep clean/offline builds independent of tarkov.dev availability. -->
		<AdditionalFiles Include="TarkovDev.gql.schema.json" CacheObjects="true" />
		<Content Update="TarkovDev.gql.schema.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<!-- In-repo scan engine (vendored RatEye sources under src/ScanEngine; do not restore NuGet RatEye). -->
		<ProjectReference Include="..\ScanEngine\RatEye.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Data\maps.json" />
		<Content Remove="wwwroot\interactableOverlay.html" />
	</ItemGroup>

	<ItemGroup>
		<!-- Explicit include so Data is still copied to bin/publish after DefaultItemExcludes removed it. -->
		<!-- Watch=false: icon dumps must not restart the dev loop. -->
		<Content Include="Data\**" Watch="false">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\RatLogoMedium.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<Content Update="_Imports.razor">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>
</Project>
