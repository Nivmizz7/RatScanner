@inject LocalizationService Localizer
@inject ISnackbar Snackbar

<div class="game-mode-switch">
	<MudToggleGroup T="RatScanner.TarkovDev.GameMode"
	                Value="@RatConfig.GameMode"
	                ValueChanged="SetGameModeAsync"
	                Size="Size.Small"
	                Color="Color.Primary"
	                CheckMark="true"
	                FixedContent="true">
		<MudToggleItem T="RatScanner.TarkovDev.GameMode"
		               Value="RatScanner.TarkovDev.GameMode.Regular"
		               Text="@Localizer["PvpMode"]" />
		<MudToggleItem T="RatScanner.TarkovDev.GameMode"
		               Value="RatScanner.TarkovDev.GameMode.Pve"
		               Text="@Localizer["PveMode"]" />
	</MudToggleGroup>
</div>

@code {
	private async System.Threading.Tasks.Task SetGameModeAsync(RatScanner.TarkovDev.GameMode gameMode)
	{
		if (gameMode == RatConfig.GameMode)
			return;

		try
		{
			await RatConfig.SetGameModeAsync(gameMode);
			await InvokeAsync(StateHasChanged);
		}
		catch (Exception exception)
		{
			Logger.LogWarning("Unable to switch game mode.", exception);
			Snackbar.Add(Localizer["GameModeSwitchFailed"], Severity.Error);
		}
	}
}
