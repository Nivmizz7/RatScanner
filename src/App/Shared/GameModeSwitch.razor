@inject LocalizationService Localizer
@inject ISnackbar Snackbar
@implements IDisposable

<div class="game-mode-switch">
	<MudSelect T="RatScanner.TarkovDev.GameMode"
	           Value="@RatConfig.GameMode"
	           ValueChanged="SetGameModeAsync"
	           Label="@Localizer["GameMode"]"
	           Variant="Variant.Outlined"
	           Margin="Margin.Dense"
	           Dense="true"
	           FullWidth="true"
	           Strict="true"
	           Disabled="@_switching">
		<MudSelectItem T="RatScanner.TarkovDev.GameMode"
		               Value="RatScanner.TarkovDev.GameMode.Regular">
			@Localizer["PvpMode"]
		</MudSelectItem>
		<MudSelectItem T="RatScanner.TarkovDev.GameMode"
		               Value="RatScanner.TarkovDev.GameMode.Pve">
			@Localizer["PveMode"]
		</MudSelectItem>
		<MudSelectItem T="RatScanner.TarkovDev.GameMode"
		               Value="RatScanner.TarkovDev.GameMode.Seasonal">
			@Localizer["SeasonalMode"]
		</MudSelectItem>
	</MudSelect>
</div>

@code {
	private bool _switching;

	protected override void OnInitialized()
	{
		// Re-render when a mode switch completes from another component.
		RatConfig.SettingsChanged += OnSettingsChanged;
	}

	private void OnSettingsChanged()
	{
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		RatConfig.SettingsChanged -= OnSettingsChanged;
	}

	private async System.Threading.Tasks.Task SetGameModeAsync(RatScanner.TarkovDev.GameMode gameMode)
	{
		if (gameMode == RatConfig.GameMode || _switching)
			return;

		_switching = true;
		try
		{
			await RatConfig.SetGameModeAsync(gameMode);
			await InvokeAsync(StateHasChanged);
		}
		catch (Exception exception)
		{
			Logger.LogWarning("Unable to switch game mode.", exception);
			Snackbar.Add(Localizer["GameModeSwitchFailed"], Severity.Error);
		}
		finally
		{
			_switching = false;
			await InvokeAsync(StateHasChanged);
		}
	}
}
