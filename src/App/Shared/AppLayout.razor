@inherits LayoutComponentBase
@layout MainLayout
@inject LocalizationService Localizer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AppStateService AppState
@implements IDisposable

<div class="app-shell">
	<aside id="primary-sidebar"
	       @ref="_sidebar"
	       class="sidebar @SidebarClasses"
	       @onkeydown="HandleKey"
	       tabindex="-1"
	       aria-label="@Localizer["PrimaryNavigation"]">
		<nav aria-label="@Localizer["PrimaryNavigation"]">
			<NavLink href="/app"
			         Match="NavLinkMatch.All"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["ScanNav"]">
				<MudIcon Icon="@Icons.Material.Filled.DocumentScanner" />
				<span>@Localizer["ScanNav"]</span>
			</NavLink>

			<NavLink href="/app/history"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["HistoryNav"]">
				<MudIcon Icon="@Icons.Material.Filled.History" />
				<span>@Localizer["HistoryNav"]</span>
			</NavLink>

			<NavLink href="/app/settings/general"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["SettingsNavGroup"]">
				<MudIcon Icon="@Icons.Material.Filled.Settings" />
				<span>@Localizer["SettingsNavGroup"]</span>
			</NavLink>

			<NavLink href="/app/credits"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["CreditsNav"]">
				<MudIcon Icon="@Icons.Material.Filled.Info" />
				<span>@Localizer["CreditsNav"]</span>
			</NavLink>
		</nav>
	</aside>

	@if (_isNarrow && AppState.DrawerOpen)
	{
		<button class="scrim"
		        type="button"
		        aria-label="@Localizer["CloseNavigation"]"
		        @onclick="CloseDrawerAsync"></button>
	}

	<main class="main-content @(_isNarrow ? null : "sidebar-docked")"
	      aria-hidden="@(_isNarrow && AppState.DrawerOpen ? "true" : null)"
	      @attributes="MainAttributes">
		@Body
	</main>
</div>

@code {
	private ElementReference _sidebar;
	private DotNetObjectReference<AppLayout>? _dotNetRef;
	private bool _isNarrow;

	private Dictionary<string, object> MainAttributes
	{
		get
		{
			Dictionary<string, object> attrs = new() { ["tabindex"] = "-1" };
			if (_isNarrow && AppState.DrawerOpen)
				attrs["inert"] = true;
			return attrs;
		}
	}

	private string SidebarClasses =>
		(_isNarrow, AppState.DrawerOpen, AppState.DesktopSidebarOpen) switch
		{
			(true, true, _) => "open overlay",
			(true, false, _) => "overlay",
			(false, _, true) => "open",
			(false, _, false) => "rail",
		};

	protected override void OnInitialized()
	{
		Navigation.LocationChanged += OnLocationChanged;
		AppState.SidebarToggleRequested += OnSidebarToggleRequested;
		base.OnInitialized();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
			return;

		_dotNetRef = DotNetObjectReference.Create(this);
		await JS.InvokeVoidAsync("RatScanner.registerViewportRef", _dotNetRef);

		_isNarrow = await JS.InvokeAsync<bool>("RatScanner.isNarrow");
		AppState.IsNarrow = _isNarrow;

		await SyncSidebarStateAsync();
		StateHasChanged();
	}

	[JSInvokable]
	public void OnViewportNarrow(bool isNarrow)
	{
		if (_isNarrow == isNarrow)
			return;

		_isNarrow = isNarrow;
		AppState.IsNarrow = _isNarrow;
		_ = SyncSidebarStateAsync();
		StateHasChanged();
	}

	[JSInvokable]
	public void CloseDrawerFromJs()
	{
		if (_isNarrow && AppState.DrawerOpen)
			_ = CloseDrawerAsync();
	}

	private void OnSidebarToggleRequested(object? sender, EventArgs e)
	{
		// Raised from the WPF UI thread (PageSwitcher title-bar button); marshal
		// to the Blazor render thread before touching component state.
		_ = InvokeAsync(ToggleAsync);
	}

	private async Task ToggleAsync()
	{
		if (_isNarrow)
		{
			if (AppState.DrawerOpen)
				await CloseDrawerAsync();
			else
				await OpenDrawerAsync();
		}
		else
		{
			AppState.SetDesktopSidebarOpen(!AppState.DesktopSidebarOpen);
			await SyncSidebarStateAsync();
			StateHasChanged();
		}
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		if (_isNarrow && AppState.DrawerOpen)
			_ = CloseDrawerAsync();
	}

	private async Task CloseDrawerAfterNavAsync()
	{
		if (_isNarrow && AppState.DrawerOpen)
			await CloseDrawerAsync();
	}

	private async Task CloseDrawerAsync()
	{
		AppState.SetDrawerOpen(false);
		await SyncSidebarStateAsync();
		StateHasChanged();
		AppState.RequestFocusNavigationToggle();
	}

	private async Task OpenDrawerAsync()
	{
		AppState.SetDrawerOpen(true);
		await SyncSidebarStateAsync();
		StateHasChanged();
		await _sidebar.FocusAsync();
	}

	private async Task HandleKey(KeyboardEventArgs e)
	{
		if (e.Key == "Escape" && _isNarrow && AppState.DrawerOpen)
			await CloseDrawerAsync();
	}

	private async Task SyncSidebarStateAsync()
	{
		try
		{
			await JS.InvokeVoidAsync("RatScanner.setSidebarState", GetSidebarStateName());
		}
		catch (JSDisconnectedException)
		{
			// The Blazor circuit can disconnect during app shutdown.
		}
	}

	private string GetSidebarStateName() =>
		_isNarrow
			? AppState.DrawerOpen ? "narrow-open" : "narrow-closed"
			: AppState.DesktopSidebarOpen ? "expanded" : "rail";

	public void Dispose()
	{
		AppState.SidebarToggleRequested -= OnSidebarToggleRequested;
		Navigation.LocationChanged -= OnLocationChanged;
		_dotNetRef?.Dispose();
	}
}
