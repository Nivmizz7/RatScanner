@inherits LayoutComponentBase
@layout MainLayout
@inject MenuVM MenuVM
@inject LocalizationService Localizer

<div class="app-shell">
    <header class="compact-bar">
        <button class="icon-button" aria-label="Open navigation" @onclick="OpenDrawer">
            <MudIcon Icon="@Icons.Material.Filled.Menu" />
        </button>
        <span class="compact-title">@Constants.Branding.Name</span>
        <div class="compact-status">
            <ScannerStatus Compact="true" />
        </div>
    </header>
    <aside class="sidebar @(_drawerOpen ? "open" : null)" @onkeydown="HandleKey">
        <div class="product-identity">
            <img src="RatLogoMedium.png" alt="" />
            <strong>@Constants.Branding.Name</strong>
            <span>@Localizer["TarkovTrackerEdition"]</span>
        </div>
        <nav aria-label="Primary navigation">
            <NavLink href="/app" Match="NavLinkMatch.All">
                <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" /> <span>Scan</span>
            </NavLink>
            <NavLink href="/app/history">
                <MudIcon Icon="@Icons.Material.Filled.History" /> <span>History</span>
            </NavLink>
            <NavLink href="/app/settings/general">
                <MudIcon Icon="@Icons.Material.Filled.Settings" /> <span>Settings</span>
            </NavLink>
            <NavLink href="/app/credits">
                <MudIcon Icon="@Icons.Material.Filled.Info" /> <span>@Localizer["CreditsNav"]</span>
            </NavLink>
        </nav>
        <div class="sidebar-spacer"></div>
        <footer aria-label="Application version">
            <span>@MenuVM.VersionDisplay</span>
        </footer>
    </aside>
    @if (_drawerOpen)
    {
        <button class="scrim" aria-label="Close navigation" @onclick="CloseDrawer"></button>
    }
    <main class="main-content">@Body</main>
</div>

@code {
    private bool _drawerOpen;

    private void OpenDrawer() => _drawerOpen = true;
    private void CloseDrawer() => _drawerOpen = false;
    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseDrawer();
    }
}
