@using System.Collections.Generic
@using GameMode = RatScanner.TarkovDev.GameMode
@inherits LayoutComponentBase
@layout MainLayout
@inject MenuVM MenuVM
@inject LocalizationService Localizer
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable

<div class="app-shell">
    <header class="compact-bar"
            aria-hidden="@(_drawerOpen ? "true" : null)"
            @attributes="_headerAttributes">
        <button class="icon-button"
                @ref="_toggleButton"
                aria-label="@Localizer["OpenNavigation"]"
                aria-controls="primary-sidebar"
                aria-expanded="@_drawerOpen"
                @onclick="ToggleDrawerAsync">
            <MudIcon Icon="@Icons.Material.Filled.Menu" />
        </button>
        <span class="compact-title">@Constants.Branding.Name</span>
        <div class="compact-status">
            <ScannerStatus Compact="true" />
        </div>
    </header>
    <aside id="primary-sidebar"
           @ref="_sidebar"
           class="sidebar @(_drawerOpen ? "open" : null)"
           @onkeydown="HandleKey"
           tabindex="-1">
        <div class="sidebar-header">
            <div class="product-identity">
                <img src="RatLogoMedium.png" alt="" />
                <strong>@Constants.Branding.Name</strong>
                <span>@MenuVM.VersionDisplay</span>
            </div>
            <button class="icon-button sidebar-close"
                    aria-label="@Localizer["CloseNavigation"]"
                    @onclick="CloseDrawerAsync">
                <MudIcon Icon="@Icons.Material.Filled.Close" />
            </button>
        </div>
        <nav aria-label="@Localizer["PrimaryNavigation"]">
            <NavLink href="/app" Match="NavLinkMatch.All" @onclick="CloseDrawerAfterNavAsync">
                <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" /> <span>@Localizer["ScanNav"]</span>
            </NavLink>
            <NavLink href="/app/history" @onclick="CloseDrawerAfterNavAsync">
                <MudIcon Icon="@Icons.Material.Filled.History" /> <span>@Localizer["HistoryNav"]</span>
            </NavLink>
            <NavLink href="/app/settings/general" @onclick="CloseDrawerAfterNavAsync">
                <MudIcon Icon="@Icons.Material.Filled.Settings" /> <span>@Localizer["SettingsNavGroup"]</span>
            </NavLink>
            <NavLink href="/app/credits" @onclick="CloseDrawerAfterNavAsync">
                <MudIcon Icon="@Icons.Material.Filled.Info" /> <span>@Localizer["CreditsNav"]</span>
            </NavLink>
        </nav>
        <div class="sidebar-spacer"></div>
        <section class="game-mode" aria-label="@Localizer["GameMode"]">
            <span>@Localizer["GameMode"]</span>
            <MudToggleGroup T="GameMode"
                            Value="@RatConfig.GameMode"
                            ValueChanged="SetGameModeAsync"
                            Disabled="_changingGameMode"
                            Size="Size.Small"
                            Color="Color.Primary"
                            CheckMark="true"
                            FixedContent="true">
                <MudToggleItem T="GameMode" Value="GameMode.Regular" Text="@Localizer["PvpMode"]" />
                <MudToggleItem T="GameMode" Value="GameMode.Pve" Text="@Localizer["PveMode"]" />
            </MudToggleGroup>
            @if (TrackerNeedsAttention)
            {
                <NavLink href="/app/settings/tracking" class="tracker-attention" @onclick="CloseDrawerAfterNavAsync">
                    @TrackerAttentionMessage
                </NavLink>
            }
        </section>
    </aside>
    @if (_drawerOpen)
    {
        <button class="scrim" aria-label="@Localizer["CloseNavigation"]" @onclick="CloseDrawerAsync"></button>
    }
    @* inert + aria-hidden keep Tab out of main content while the drawer is open. *@
    <main class="main-content"
          aria-hidden="@(_drawerOpen ? "true" : null)"
          @attributes="_mainAttributes">@Body</main>
</div>

@code {
    private bool _drawerOpen;
    private bool _changingGameMode;
    private ElementReference _sidebar;
    private ElementReference _toggleButton;
    private bool _subscribed;

    private bool TrackerNeedsAttention =>
        RatScannerMain.Instance.TarkovTrackerDB.ConnectionState
            is TrackerConnectionState.NotConfigured
                or TrackerConnectionState.InvalidKey
                or TrackerConnectionState.MissingPermissions
                or TrackerConnectionState.ConnectionError;

    private string TrackerAttentionMessage =>
        RatConfig.GameMode == GameMode.Pve
            ? Localizer["TrackerNotConnectedPve"]
            : Localizer["TrackerNotConnectedPvp"];

    private Dictionary<string, object> _mainAttributes =>
        _drawerOpen
            ? new Dictionary<string, object> { ["inert"] = true }
            : new Dictionary<string, object>();

    private Dictionary<string, object> _headerAttributes =>
        _drawerOpen
            ? new Dictionary<string, object> { ["inert"] = true }
            : new Dictionary<string, object>();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _subscribed = true;
    }

    private async Task OpenDrawerAsync()
    {
        _drawerOpen = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await _sidebar.FocusAsync();
        }
        catch
        {
            // Focus is best-effort; keep drawer open even if the element is not focusable yet.
        }
    }

    private Task ToggleDrawerAsync() => _drawerOpen ? CloseDrawerAsync() : OpenDrawerAsync();

    private async Task CloseDrawerAsync()
    {
        if (!_drawerOpen)
            return;
        _drawerOpen = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            await _toggleButton.FocusAsync();
        }
        catch
        {
            // Same best-effort policy as open.
        }
    }

    private Task CloseDrawerAfterNavAsync() => CloseDrawerAsync();

    private async Task SetGameModeAsync(GameMode gameMode)
    {
        if (_changingGameMode || gameMode == RatConfig.GameMode)
            return;

        _changingGameMode = true;
        try
        {
            await RatConfig.SetGameModeAsync(gameMode);
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Unable to switch game mode.", exception);
            Snackbar.Add(Localizer["GameModeSwitchFailed"], Severity.Error);
        }
        finally
        {
            _changingGameMode = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_drawerOpen)
            return;
        _ = InvokeAsync(CloseDrawerAsync);
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _ = CloseDrawerAsync();
    }

    public void Dispose()
    {
        if (_subscribed)
            Navigation.LocationChanged -= OnLocationChanged;
    }
}
