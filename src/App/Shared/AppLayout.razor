@inherits LayoutComponentBase
@layout MainLayout
@inject LocalizationService Localizer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AppStateService AppState
@implements IDisposable

<div class="app-shell">
	<aside id="primary-sidebar"
	       @ref="_sidebar"
	       class="sidebar @SidebarClasses"
	       @onkeydown="HandleKey"
	       tabindex="-1"
	       aria-label="@Localizer["PrimaryNavigation"]">
		<nav aria-label="@Localizer["PrimaryNavigation"]">
			<NavLink href="/app"
			         Match="NavLinkMatch.All"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["ScanNav"]">
				<MudIcon Icon="@Icons.Material.Filled.DocumentScanner" />
				<span>@Localizer["ScanNav"]</span>
			</NavLink>

			<NavLink href="/app/history"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["HistoryNav"]">
				<MudIcon Icon="@Icons.Material.Filled.History" />
				<span>@Localizer["HistoryNav"]</span>
			</NavLink>

			<NavLink href="/app/settings/general"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["SettingsNavGroup"]">
				<MudIcon Icon="@Icons.Material.Filled.Settings" />
				<span>@Localizer["SettingsNavGroup"]</span>
			</NavLink>

			<NavLink href="/app/credits"
			         @onclick="CloseDrawerAfterNavAsync"
			         title="@Localizer["CreditsNav"]">
				<MudIcon Icon="@Icons.Material.Filled.Info" />
				<span>@Localizer["CreditsNav"]</span>
			</NavLink>
		</nav>
	</aside>

	@if (_isNarrow && _sidebarOpen)
	{
		<button class="scrim"
		        type="button"
		        aria-label="@Localizer["CloseNavigation"]"
		        @onclick="CloseDrawerAsync"></button>
	}

	<main class="main-content @(_isNarrow ? null : "sidebar-docked")"
	      aria-hidden="@(_isNarrow && _sidebarOpen ? "true" : null)"
	      @attributes="_mainAttributes">
		@Body
	</main>
</div>

@code {
	private ElementReference _sidebar;
	private DotNetObjectReference<AppLayout>? _dotNetRef;
	private bool _sidebarOpen = true;
	private bool _isNarrow;
	private Dictionary<string, object> _mainAttributes = new() { ["tabindex"] = "-1" };

	private string SidebarClasses =>
		(_isNarrow, _sidebarOpen) switch
		{
			(true, true) => "open overlay",
			(true, false) => "overlay",
			(false, true) => "open",
			(false, false) => "rail",
		};

	protected override void OnInitialized()
	{
		Navigation.LocationChanged += OnLocationChanged;
		AppState.SidebarOpenChanged += OnSidebarOpenChanged;
		base.OnInitialized();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
			return;

		_dotNetRef = DotNetObjectReference.Create(this);
		await JS.InvokeVoidAsync("RatScanner.registerViewportRef", _dotNetRef);
		_isNarrow = await JS.InvokeAsync<bool>("RatScanner.isNarrow");

		_sidebarOpen = !_isNarrow;
		AppState.SetSidebarOpen(_sidebarOpen);
		await SyncSidebarStateAsync();
		StateHasChanged();
	}

	[JSInvokable]
	public void OnViewportNarrow(bool isNarrow)
	{
		if (_isNarrow == isNarrow)
			return;

		_isNarrow = isNarrow;
		_ = SyncSidebarStateAsync();
		StateHasChanged();
	}

	[JSInvokable]
	public void CloseDrawerFromJs()
	{
		if (_isNarrow && _sidebarOpen)
			_ = CloseDrawerAsync();
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		if (_isNarrow && _sidebarOpen)
			_ = CloseDrawerAsync();
	}

	private async Task CloseDrawerAfterNavAsync()
	{
		if (_isNarrow && _sidebarOpen)
			await CloseDrawerAsync();
	}

	private async Task CloseDrawerAsync()
	{
		_sidebarOpen = false;
		AppState.SetSidebarOpen(false);
		await SyncSidebarStateAsync();
		StateHasChanged();
		AppState.RequestFocusNavigationToggle();
	}

	private async Task OpenDrawerAsync()
	{
		_sidebarOpen = true;
		AppState.SetSidebarOpen(true);
		await SyncSidebarStateAsync();
		StateHasChanged();
		await _sidebar.FocusAsync();
	}

	private async Task HandleKey(KeyboardEventArgs e)
	{
		if (e.Key == "Escape" && _isNarrow && _sidebarOpen)
			await CloseDrawerAsync();
	}

	private async Task SyncSidebarStateAsync()
	{
		try
		{
			await JS.InvokeVoidAsync("RatScanner.setSidebarState", _sidebarOpen, _isNarrow);
		}
		catch (JSDisconnectedException)
		{
			// The Blazor circuit can disconnect during app shutdown.
		}
	}

	private async void OnSidebarOpenChanged(object? sender, bool open)
	{
		await InvokeAsync(async () =>
		{
			if (_sidebarOpen == open)
				return;

			_sidebarOpen = open;
			await SyncSidebarStateAsync();
			StateHasChanged();

			if (_sidebarOpen && _isNarrow)
				await _sidebar.FocusAsync();
		});
	}

	public void Dispose()
	{
		AppState.SidebarOpenChanged -= OnSidebarOpenChanged;
		Navigation.LocationChanged -= OnLocationChanged;
		_dotNetRef?.Dispose();
	}
}
