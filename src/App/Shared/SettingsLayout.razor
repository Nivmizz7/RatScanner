@inherits LayoutComponentBase
@layout AppLayout
@using RatScanner.Pages.App.Settings
@inject LocalizationService Localizer

<div class="settings-shell">
    <aside>
        <h1>@Localizer["SettingsNavGroup"]</h1>
        <nav aria-label="@Localizer["SettingsSections"]">
            <NavLink href="/app/settings/general">@Localizer["GeneralNav"]</NavLink>
            <NavLink href="/app/settings/scanning">@Localizer["ScanningNav"]</NavLink>
            <NavLink href="/app/settings/tracking">@Localizer["TrackingNav"]</NavLink>
            <NavLink href="/app/settings/minimal">@Localizer["MinimalNav"]</NavLink>
            <NavLink href="/app/settings/interactableOverlay">@Localizer["OverlayNav"]</NavLink>
        </nav>
    </aside>
    <section class="settings-content">@Body<SettingsSave /></section>
</div>
