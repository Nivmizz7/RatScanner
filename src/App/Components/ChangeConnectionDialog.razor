@using System.Threading
@using GameMode = RatScanner.TarkovDev.GameMode
@using PvpSource = RatScanner.TarkovDev.PvpSource
@implements IDisposable
<MudDialog ContentClass="change-connection-dialog">
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Surface" Class="mb-3">@Localizer["ChangeConnectionSafety"]</MudText>

        @if (ShowProviderChoice)
        {
            <p class="source-label">@Localizer["ConnectionSource"]</p>
            <MudRadioGroup T="PvpSource"
                           Value="@_draftSource"
                           ValueChanged="OnDraftSourceChanged"
                           Class="source-cards">
                <div class="@(_draftSource == PvpSource.Org ? "source-card source-card-selected" : "source-card")"
                         @onclick="() => OnDraftSourceChanged(PvpSource.Org)">
                    <MudRadio T="PvpSource" Value="PvpSource.Org" />
                    <div class="source-card-body">
                        <div class="source-card-title">
                            @Localizer["SourceOrg"]
                            <span class="source-badge source-badge-recommended">@Localizer["SourceOrgRecommended"]</span>
                        </div>
                        <div class="source-card-detail">@Localizer["SourceOrgSupports"]</div>
                    </div>
                </div>
                <div class="@(_draftSource == PvpSource.Io ? "source-card source-card-selected" : "source-card")"
                         @onclick="() => OnDraftSourceChanged(PvpSource.Io)">
                    <MudRadio T="PvpSource" Value="PvpSource.Io" />
                    <div class="source-card-body">
                        <div class="source-card-title">
                            @Localizer["SourceIo"]
                            <span class="source-badge source-badge-legacy">@Localizer["SourceIoPvpOnly"]</span>
                        </div>
                        <div class="source-card-detail">@Localizer["SourceIoSupports"]</div>
                    </div>
                </div>
            </MudRadioGroup>
            <p class="source-shared-note">@Localizer["SourceSharedNote"]</p>
        }

        <MudTextField T="string"
                      @bind-Value="_tokenDraft"
                      Label="@Localizer["ApiToken"]"
                      InputType="@(_tokenVisible ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Disabled="_testing"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_tokenVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentAriaLabel="@(_tokenVisible ? Localizer["HideApiKey"] : Localizer["ShowApiKey"])"
                      OnAdornmentClick="@(() => _tokenVisible = !_tokenVisible)"
                      OnKeyDown="HandleKeyDownAsync" />

        @if (_error is not null)
        {
            <p class="inline-error" role="alert">@_error</p>
        }

        <MudLink Href="@ManageKeyUrl" Target="_blank" Typo="Typo.body2" Class="tracker-manage-link">
            @ManageKeyLabel
        </MudLink>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_testing" OnClick="Cancel">@Localizer["CancelButton"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanSubmit)"
                   OnClick="SubmitAsync">
            @if (_testing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_testing ? Localizer["Connecting"] : Localizer["ReplaceConnection"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance DialogInstance { get; set; } = null!;

    [Parameter]
    public GameMode Mode { get; set; }

    [Parameter]
    public PvpSource CurrentSource { get; set; }

    [Parameter]
    public bool ShowProviderChoice { get; set; }

    [Parameter]
    public string ModeLabel { get; set; } = "";

    [Parameter]
    public string ManageKeyLabel { get; set; } = "";

    [Inject]
    SettingsVM SettingsVM { get; set; } = null!;

    [Inject]
    LocalizationService Localizer { get; set; } = null!;

    [Inject]
    ISnackbar Snackbar { get; set; } = null!;

    private PvpSource _draftSource;
    private string _tokenDraft = "";
    private string? _error;
    private bool _tokenVisible;
    private bool _testing;
    private CancellationTokenSource? _validation;

    protected override void OnInitialized()
    {
        _draftSource = CurrentSource;
    }

    private bool CanSubmit => !_testing && !string.IsNullOrWhiteSpace(_tokenDraft);

    private bool IsIoDraft => ShowProviderChoice && _draftSource == PvpSource.Io;

    // Compute the manage-key URL from the draft source so switching providers
    // inside the dialog updates the link. PvE always uses the org site.
    private string ManageKeyUrl => IsIoDraft
        ? Constants.Links.TarkovTrackerIo
        : Constants.Links.TarkovTracker;

    private void OnDraftSourceChanged(PvpSource source)
    {
        _draftSource = source;
        _error = null;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SubmitAsync();
    }

    private void Cancel()
    {
        _validation?.Cancel();
        _validation?.Dispose();
        DialogInstance.Cancel();
    }

    private async Task SubmitAsync()
    {
        string candidate = _tokenDraft.Trim();
        if (string.IsNullOrWhiteSpace(candidate) || _testing)
            return;

        _validation?.Cancel();
        _validation?.Dispose();
        CancellationTokenSource cancellation = new();
        _validation = cancellation;
        _testing = true;
        _error = null;
        try
        {
            TrackerValidationResult result = IsIoDraft
                ? await RatScannerMain.Instance.ValidateTarkovTrackerIoKeyAsync(candidate, cancellation.Token)
                : await RatScannerMain.Instance.ValidateTarkovTrackerOrgKeyAsync(Mode, candidate, cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();
            if (!result.Succeeded)
            {
                _error = ValidationMessage(result);
                return;
            }

            SettingSaveResult saved;
            if (IsIoDraft)
            {
                string previousIo = RatConfig.Tracking.TarkovTracker.IoToken;
                saved = await CredentialPersistenceCoordinator.PersistCandidateAsync(
                    () => SettingsVM.SetTarkovTrackerIoTokenAsync(candidate),
                    () => SettingsVM.SetTarkovTrackerIoTokenAsync(previousIo),
                    cancellation.Token
                );
                if (saved.Succeeded && RatConfig.Tracking.TarkovTracker.PvpSource != PvpSource.Io)
                {
                    SettingSaveResult sourceResult = await SettingsVM.SetTarkovTrackerPvpSourceAsync(PvpSource.Io);
                    if (!sourceResult.Succeeded)
                    {
                        // Roll back the token so config stays consistent with the
                        // unchanged source. Fail closed: keep dialog open with error.
                        _ = await SettingsVM.SetTarkovTrackerIoTokenAsync(previousIo);
                        _error = Localizer["CredentialSaveFailed"];
                        return;
                    }
                }
            }
            else
            {
                string previousOrg = RatConfig.Tracking.TarkovTracker.TokenForMode(Mode);
                saved = await CredentialPersistenceCoordinator.PersistCandidateAsync(
                    () => SettingsVM.SetTarkovTrackerOrgTokenAsync(Mode, candidate),
                    () => SettingsVM.SetTarkovTrackerOrgTokenAsync(Mode, previousOrg),
                    cancellation.Token
                );
                if (saved.Succeeded && Mode == GameMode.Regular && RatConfig.Tracking.TarkovTracker.PvpSource != PvpSource.Org)
                {
                    SettingSaveResult sourceResult = await SettingsVM.SetTarkovTrackerPvpSourceAsync(PvpSource.Org);
                    if (!sourceResult.Succeeded)
                    {
                        // Roll back the token so config stays consistent with the
                        // unchanged source. Fail closed: keep dialog open with error.
                        _ = await SettingsVM.SetTarkovTrackerOrgTokenAsync(Mode, previousOrg);
                        _error = Localizer["CredentialSaveFailed"];
                        return;
                    }
                }
            }
            if (!saved.Succeeded)
            {
                _error = Localizer["CredentialSaveFailed"];
                return;
            }

            // Activate only when this credential drives the active game mode.
            // At this point PvpSource always equals _draftSource: the source
            // change above either succeeded (setting PvpSource = _draftSource)
            // or was skipped because they already matched, so the PvP-source
            // mismatch guard is redundant and only the game-mode check matters.
            bool drivesActiveMode = RatConfig.GameMode == Mode;
            if (drivesActiveMode)
                await RatScannerMain.Instance.ActivateTrackerModeAsync(Mode, cancellation.Token);

            DialogInstance.Close(DialogResult.Ok(true));
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (_validation == cancellation)
            {
                _testing = false;
                _validation = null;
                cancellation.Dispose();
            }
        }
    }

    private string ValidationMessage(TrackerValidationResult result) => result.Failure switch
    {
        TrackerValidationFailure.InvalidKey => Localizer["CredentialInvalid"],
        TrackerValidationFailure.WrongGameMode => Localizer.Format("CredentialWrongMode", ModeLabel),
        TrackerValidationFailure.MissingPermissions => result.MissingPermissions.Count > 0
            ? Localizer.Format("CredentialMissingPermissions", string.Join(", ", result.MissingPermissions))
            : Localizer["CredentialMissingPermissionGeneric"],
        TrackerValidationFailure.RateLimited => Localizer["CredentialRateLimited"],
        TrackerValidationFailure.ServiceUnavailable => Localizer["CredentialServiceUnavailable"],
        TrackerValidationFailure.Network => Localizer["CredentialNetworkError"],
        _ => Localizer["CredentialUnexpectedResponse"],
    };

    // Cancel any in-flight validation/persist when the dialog is dismissed
    // via Escape, backdrop click, or title-bar close — not just the Cancel
    // button. Prevents a dismissed replace from mutating config after close.
    public void Dispose()
    {
        _validation?.Cancel();
        _validation?.Dispose();
        _validation = null;
    }
}
