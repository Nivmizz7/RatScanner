@using System.Threading
@using RatScanner.Runtime
@using GameMode = RatScanner.TarkovDev.GameMode
@implements IDisposable
<MudDialog ContentClass="change-connection-dialog">
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Surface" Class="mb-3">@Localizer["ChangeConnectionSafety"]</MudText>

        <MudTextField T="string"
                      @bind-Value="_tokenDraft"
                      Label="@Localizer["ApiToken"]"
                      InputType="@(_tokenVisible ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Disabled="_testing"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_tokenVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentAriaLabel="@(_tokenVisible ? Localizer["HideApiKey"] : Localizer["ShowApiKey"])"
                      OnAdornmentClick="@(() => _tokenVisible = !_tokenVisible)"
                      OnKeyDown="HandleKeyDownAsync" />

        @if (_error is not null)
        {
            <p class="inline-error" role="alert">@_error</p>
        }

        <MudLink Href="@Constants.Links.TarkovTrackerSettings" Target="_blank" Typo="Typo.body2" Class="tracker-manage-link">
            @Localizer["ManageApiKeys"]
        </MudLink>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_testing" OnClick="Cancel">@Localizer["CancelButton"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanSubmit)"
                   OnClick="SubmitAsync">
            @if (_testing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_testing ? Localizer["Connecting"] : Localizer["ReplaceConnection"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance DialogInstance { get; set; } = null!;

    [Parameter]
    public GameMode Mode { get; set; }

    [Parameter]
    public string ModeLabel { get; set; } = "";

    [Inject]
    SettingsVM SettingsVM { get; set; } = null!;

    [Inject]
    LocalizationService Localizer { get; set; } = null!;

    [Inject]
    ITrackerService TrackerService { get; set; } = null!;

    private string _tokenDraft = "";
    private string? _error;
    private bool _tokenVisible;
    private bool _testing;
    private CancellationTokenSource? _validation;

    private bool CanSubmit => !_testing && !string.IsNullOrWhiteSpace(_tokenDraft);

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SubmitAsync();
    }

    private void Cancel()
    {
        _validation?.Cancel();
        _validation?.Dispose();
        DialogInstance.Cancel();
    }

    private async Task SubmitAsync()
    {
        string candidate = _tokenDraft.Trim();
        if (string.IsNullOrWhiteSpace(candidate) || _testing)
            return;

        _validation?.Cancel();
        _validation?.Dispose();
        CancellationTokenSource cancellation = new();
        _validation = cancellation;
        _testing = true;
        _error = null;
        try
        {
            TrackerValidationResult result = await TrackerService.ValidateOrgKeyAsync(
                Mode,
                candidate,
                cancellation.Token
            );
            cancellation.Token.ThrowIfCancellationRequested();
            if (!result.Succeeded)
            {
                _error = ValidationMessage(result);
                return;
            }

            string previousToken = RatConfig.Tracking.TarkovTracker.TokenForMode(Mode);
            SettingSaveResult saved = await CredentialPersistenceCoordinator.PersistCandidateAsync(
                () => SettingsVM.SetTarkovTrackerOrgTokenAsync(Mode, candidate),
                () => SettingsVM.SetTarkovTrackerOrgTokenAsync(Mode, previousToken),
                cancellation.Token
            );
            if (!saved.Succeeded)
            {
                _error = Localizer["CredentialSaveFailed"];
                return;
            }

            if (RatConfig.GameMode == Mode)
                await TrackerService.ActivateModeAsync(Mode, cancellation.Token);

            DialogInstance.Close(DialogResult.Ok(true));
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (_validation == cancellation)
            {
                _testing = false;
                _validation = null;
                cancellation.Dispose();
            }
        }
    }

    private string ValidationMessage(TrackerValidationResult result) => result.Failure switch
    {
        TrackerValidationFailure.InvalidKey => Localizer["CredentialInvalid"],
        TrackerValidationFailure.WrongGameMode => Localizer.Format("CredentialWrongMode", ModeLabel),
        TrackerValidationFailure.MissingPermissions => result.MissingPermissions.Count > 0
            ? Localizer.Format("CredentialMissingPermissions", string.Join(", ", result.MissingPermissions))
            : Localizer["CredentialMissingPermissionGeneric"],
        TrackerValidationFailure.RateLimited => Localizer["CredentialRateLimited"],
        TrackerValidationFailure.ServiceUnavailable => Localizer["CredentialServiceUnavailable"],
        TrackerValidationFailure.Network => Localizer["CredentialNetworkError"],
        _ => Localizer["CredentialUnexpectedResponse"],
    };

    public void Dispose()
    {
        _validation?.Cancel();
        _validation?.Dispose();
        _validation = null;
    }
}
