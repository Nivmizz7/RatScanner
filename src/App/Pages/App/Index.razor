@page "/"
@page "/app"
@using RatScanner.Presentation
@using RatScanner.Scan
@using RatScanner.TarkovDev
@using System.ComponentModel
@using System.Threading
@using System.Globalization
@inject MenuVM MenuVM
@inject RecentScansService RecentScansStore
@inject LocalizationService Localizer
@inject AppStateService AppState
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="scan-page">
    <div class="utility-bar">
        <div class="search">
            <MudAutocomplete @ref="_search"
                             T="Item"
                             Class="rs-search-field"
                             Placeholder="@Localizer["SearchItemsPlaceholder"]"
                             SearchFunc="SearchItems"
                             ValueChanged="SelectItem"
                             ToStringFunc="@(item => item?.Name ?? string.Empty)"
                             MaxItems="8"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             Underline="false"
                             FullWidth="true"
                             Margin="Margin.None"
                             Variant="Variant.Text"
                             AdornmentIcon="@Icons.Material.Filled.Search">
                <ItemTemplate Context="item">
                    <div class="search-result">
                        <img src="@item.IconLink" alt="" />
                        <span>@item.Name<small>@item.ShortName</small></span>
                    </div>
                </ItemTemplate>
                <NoItemsTemplate>
                    <div class="search-empty">@Localizer["NoMatchingItems"]</div>
                </NoItemsTemplate>
            </MudAutocomplete>
        </div>
        <GameModeIndicator />
        <ScannerStatus />
    </div>

    @{
        IReadOnlyList<ScanResultViewModel> recentScans = RecentScans;
    }
    @if (recentScans.Count > 0)
    {
        <section class="recent" aria-label="@Localizer["RecentScans"]">
            <span class="recent-label">@Localizer["RecentScans"]</span>
            @foreach (ScanResultViewModel scan in recentScans)
            {
                <button type="button"
                        class="thumb @(_result?.Item.Id == scan.Item.Id ? "selected" : null)"
                        title="@scan.Item.Name"
                        @onclick="() => SelectRecent(scan)">
                    <img src="@scan.Item.ImageUrl" alt="" />
                    <span>@ShortLabel(scan.Item.ShortName, scan.Item.Name)</span>
                </button>
            }
        </section>
    }

    @if (_result is null)
    {
        <section class="empty-state" aria-live="polite">
            <MudIcon Icon="@Icons.Material.Filled.CenterFocusWeak" />
            <div>
                <strong>@Localizer["ReadyToScan"]</strong>
                <span>@Localizer["ReadyToScanDescription"]</span>
            </div>
        </section>
    }
    else
    {
        @if (!IsScannerActive)
        {
            <section class="state-banner">
                <strong>@Localizer["ScannerPaused"]</strong>
                <span>@Localizer["EnableScannerInSettings"]</span>
            </section>
        }

        @if (IsLowConfidence)
        {
            <section class="state-banner warning" aria-label="@Localizer["LowConfidenceMatch"]">
                <div class="banner-copy">
                    <strong>@Localizer.Format("LowConfidenceMatchWithPercent", ConfidencePercent)</strong>
                    <span>@Localizer["LowConfidenceDescription"]</span>
                </div>
                <div class="banner-actions">
                    <button type="button" class="banner-btn" @onclick="FocusSearch">@Localizer["ChooseAnotherMatch"]</button>
                </div>
            </section>
        }

        <article class="result-card" aria-live="polite" aria-label="@Localizer["CurrentScanResult"]">
            <div class="result-main">
                <header class="identity">
                    <div class="item-art">
                        <img src="@_result.Item.ImageUrl" alt="@_result.Item.Name" />
                        @if (_result.Item.Quantity > 1)
                        {
                            <small>x@_result.Item.Quantity</small>
                        }
                    </div>
                    <div class="identity-text">
                        <h1>@DisplayName</h1>
                        <p class="identity-meta">
                            <span>@FriendlyItemType</span>
                            <span class="sep" aria-hidden="true"></span>
                            <span>@_result.Item.SlotCount @(_result.Item.SlotCount == 1 ? Localizer["Slot"] : Localizer["Slots"])</span>
                            @if (IsManual)
                            {
                                <span class="sep" aria-hidden="true"></span>
                                <span>@Localizer["ManualShort"]</span>
                            }
                        </p>
                    </div>
                </header>

                <section class="verdict @VerdictTone" aria-label="@_result.Recommendation.Title">
                    <div class="verdict-inner">
                        <span class="verdict-word">@VerdictWord</span>
                        <span class="verdict-reason">@VerdictReason</span>
                    </div>
                </section>
            </div>

            <div class="result-data">
                <section class="market" aria-label="@Localizer["MarketComparison"]">
                    <div class="market-cell">
                        <div class="market-label">
                            <span>@Localizer["FleaMarket"]</span>
                            @if (!_result.Pricing.BannedOnFlea && !string.IsNullOrWhiteSpace(FreshnessShortText))
                            {
                                <span class="freshness" title="@ExactUpdatedText">@FreshnessShortText</span>
                            }
                        </div>
                        @if (_result.Pricing.BannedOnFlea)
                        {
                            <span class="price banned">@Localizer["BannedOnFlea"]</span>
                        }
                        else
                        {
                            <span class="price">@PriceFormatter.Format(_result.Pricing.FleaPrice)</span>
                            @if (ShowPerSlot)
                            {
                                <span class="supporting">@Localizer.Format("PricePerSlotLabel", PriceFormatter.Format(_result.Pricing.FleaPricePerSlot))</span>
                            }
                        }
                    </div>

                    <div class="market-cell">
                        <div class="market-label">
                            <span>@Localizer["BestTrader"]</span>
                        </div>
                        @if (_result.Trader is null)
                        {
                            <span class="price">@Localizer["Unavailable"]</span>
                        }
                        else
                        {
                            <span class="trader-name">@(_result.Trader.Name ?? Localizer["Trader"])</span>
                            <span class="price">@PriceFormatter.Format(_result.Trader.TotalPrice)</span>
                        }
                    </div>
                </section>

                @if (HasStatusChips)
                {
                    <section class="status-strip" aria-label="@Localizer["Requirements"]">
                        @if (HasFirNeedAnywhere)
                        {
                            <span class="chip fir-badge" title="@FirTooltipText" role="note" aria-label="@Localizer["FirBadgeTitle"]">
                                <svg class="fir-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                                    <rect x="0.75" y="0.75" width="10.5" height="10.5" rx="2.5" />
                                    <path d="M3.4 6.3 5.3 8.2 8.8 3.9" />
                                </svg>
                                <span>@Localizer["FirBadgeText"]</span>
                            </span>
                        }
                        @if (_result.Quests.WeaponUsableAdvisory)
                        {
                            <span class="chip chip-advisory" title="@Localizer["UsableWeaponTooltip"]">
                                @Localizer["UsableWeaponShort"]
                            </span>
                        }
                        @if (_result.Quests.Report.FutureKnown > 0 && _result.Quests.Report.UnlockLevel is int unlockLevel)
                        {
                            <span class="chip chip-later" title="@Localizer.Format("LaterLevelTooltip", unlockLevel)">
                                @Localizer.Format("LaterLevelChip", unlockLevel)
                            </span>
                        }
                        @if (!QuestBucketsCoveredByVerdict)
                        {
                            @if (_result.Quests.Report.AvailableNow > 0)
                            {
                                <span class="chip chip-later">@Localizer.Format("QuestChipAvailable", _result.Quests.Report.AvailableNow)</span>
                            }
                            @if (_result.Quests.Report.FutureKnown > 0)
                            {
                                <span class="chip chip-later">@Localizer.Format("QuestChipLater", _result.Quests.Report.FutureKnown)</span>
                            }
                            @if (_result.Quests.Report.ConditionalUnknown > 0)
                            {
                                <span class="chip chip-later">@Localizer.Format("QuestChipConditional", _result.Quests.Report.ConditionalUnknown)</span>
                            }
                        }
                        @if (ShowHideoutChip)
                        {
                            <span class="chip chip-required" title="@HideoutChipTooltip">
                                @Localizer["HideoutLabel"]
                                <strong>@Localizer.Format("QuestChipNeeded", _result.Hideout.RemainingRequired ?? 0)</strong>
                            </span>
                        }
                        @if (_result.Acquisition.CanCraft)
                        {
                            <span class="chip" title="@Localizer["CraftableTooltip"]">
                                @Localizer["Craftable"]
                            </span>
                        }
                        @if (_result.Acquisition.CanBarter)
                        {
                            <span class="chip" title="@Localizer["BarterableTooltip"]">
                                @Localizer["Barterable"]
                            </span>
                        }
                    </section>
                }
            </div>

            <div class="actions">
                <div class="action-links">
                    <button type="button"
                            class="link-btn"
                            @onclick="OpenMarket"
                            disabled="@string.IsNullOrWhiteSpace(_result.Item.MarketUrl)">
                        @Localizer["ViewOnTarkovDev"]
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                    </button>
                    <button type="button"
                            class="link-btn"
                            @onclick="OpenWiki"
                            disabled="@string.IsNullOrWhiteSpace(_result.Item.WikiUrl)">
                        @Localizer["OpenWiki"]
                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                    </button>
                </div>
                <div class="links-menu">
                    <MudMenu AriaLabel="@Localizer["LinksMenuLabel"]"
                             Label="@Localizer["LinksMenuLabel"]"
                             Variant="Variant.Text"
                             Color="Color.Default"
                             Size="Size.Small"
                             Dense="true"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             EndIcon="@Icons.Material.Filled.ExpandMore">
                        <MudMenuItem OnClick="OpenMarket"
                                     Disabled="@string.IsNullOrWhiteSpace(_result.Item.MarketUrl)"
                                     Icon="@Icons.Material.Filled.OpenInNew">
                            @Localizer["ViewOnTarkovDev"]
                        </MudMenuItem>
                        <MudMenuItem OnClick="OpenWiki"
                                     Disabled="@string.IsNullOrWhiteSpace(_result.Item.WikiUrl)"
                                     Icon="@Icons.Material.Filled.OpenInNew">
                            @Localizer["OpenWiki"]
                        </MudMenuItem>
                    </MudMenu>
                </div>
                <button type="button"
                        class="details-toggle"
                        aria-expanded="@_detailsOpen"
                        @onclick="ToggleDetails">
                    @(_detailsOpen ? Localizer["HideDetails"] : Localizer["ShowDetails"])
                    <MudIcon Icon="@(_detailsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                </button>
            </div>

            @if (_detailsOpen)
            {
                <section class="details" aria-label="@Localizer["ScanDetails"]">
                    <div class="details-group">
                        <h3>@Localizer["ScanInformation"]</h3>
                        <div class="details-rows">
                            <div>
                                <label>@Localizer["SelectionMethod"]</label>
                                <strong>@SelectionMethodDetail</strong>
                            </div>
                            <div>
                                <label>@Localizer["ScanConfidence"]</label>
                                <strong>@ScanConfidenceDetail</strong>
                            </div>
                        </div>
                    </div>

                    <div class="details-group">
                        <h3>@Localizer["ItemInformation"]</h3>
                        <div class="details-rows">
                            <div>
                                <label>@Localizer["ItemType"]</label>
                                <strong>@FriendlyItemType</strong>
                            </div>
                            <div>
                                <label>@Localizer["InventorySize"]</label>
                                <strong>@_result.Item.Width × @_result.Item.Height</strong>
                            </div>
                            <div class="item-id-row">
                                <label>@Localizer["ItemId"]</label>
                                <div class="item-id-value">
                                    <strong class="mono">@(_result.Item.Id ?? Localizer["Unavailable"])</strong>
                                    @if (!string.IsNullOrWhiteSpace(_result.Item.Id))
                                    {
                                        <button type="button"
                                                class="copy-btn"
                                                title="@Localizer["CopyItemId"]"
                                                @onclick="CopyItemId">
                                            @(_copiedId ? Localizer["Copied"] : Localizer["Copy"])
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="details-group">
                        <h3>@Localizer["MarketData"]</h3>
                        <div class="details-rows">
                            <div>
                                <label>@Localizer["MarketDataSource"]</label>
                                <strong>@_result.Pricing.SourceName</strong>
                            </div>
                            <div>
                                <label>@Localizer["LastUpdated"]</label>
                                <strong>@ExactUpdatedText</strong>
                            </div>
                        </div>
                    </div>
                </section>
            }
        </article>
    }
</div>

@code {
    private ScanResultViewModel? _result;
    private DotNetObjectReference<Index>? _fitRef;
    private bool _disposed;
    private List<Item>? _items;
    private string? _itemsLocale;
    private TarkovDev.GameMode? _itemsGameMode;
    private MudAutocomplete<Item>? _search;
    private bool _detailsOpen;
    private bool _copiedId;

    private const float HighConfidence = 0.9f;
    private const float MediumConfidence = 0.7f;

    private bool IsScannerActive => RatConfig.NameScan.Enable || RatConfig.IconScan.Enable;
    private bool ShowPerSlot => _result is { Item.SlotCount: > 1 };
    private bool IsManual => _result?.Recognition.IsManualSelection == true;
    private bool IsLowConfidence =>
        !IsManual && _result?.Recognition.Confidence is float confidence && confidence < MediumConfidence;
    private bool HasFirNeedAnywhere =>
        (_result?.Quests.HasFirNeed == true) || (_result?.Hideout.HasFirNeed == true);

    /// <summary>
    /// Quest bucket counts are stated in the verdict reason only when the verdict is
    /// quest-driven; hideout/sell verdicts surface remaining quest buckets as chips.
    /// </summary>
    private bool QuestBucketsCoveredByVerdict =>
        _result?.Recommendation.Type
            is RecommendationType.KeepForQuest
                or RecommendationType.QuestAvailableSoon
                or RecommendationType.NeededLater
                or RecommendationType.MaybeNeeded;

    /// <summary>Hideout chip only when the verdict doesn't already state the hideout need (dedupe).</summary>
    private bool ShowHideoutChip =>
        IsRequired(_result?.Hideout)
        && _result?.Recommendation.Type != RecommendationType.KeepForHideout;

    private bool HasStatusChips =>
        HasFirNeedAnywhere
        || _result?.Quests.WeaponUsableAdvisory == true
        || (
            _result?.Quests.Report.FutureKnown > 0
            && (!QuestBucketsCoveredByVerdict || _result.Quests.Report.UnlockLevel is not null)
        )
        || (!QuestBucketsCoveredByVerdict && _result?.Quests.Report.GrandTotal > 0)
        || ShowHideoutChip
        || _result?.Acquisition.Any == true;

    private int? Difference =>
        _result?.Pricing.FleaPrice is int flea && _result.Trader?.TotalPrice is int trader
            ? flea - trader
            : null;

    private string FreshnessShortText
    {
        get
        {
            if (_result?.Pricing.UpdatedAt is not DateTimeOffset updated)
                return string.Empty;
            TimeSpan age = DateTimeOffset.UtcNow - updated.ToUniversalTime();
            if (age.TotalMinutes < 1)
                return Localizer["FreshnessNowShort"];
            if (age.TotalHours < 1)
                return Localizer.Format("FreshnessMinutesShort", (int)age.TotalMinutes);
            if (age.TotalDays < 1)
                return Localizer.Format("FreshnessHoursShort", (int)age.TotalHours);
            return Localizer.Format("FreshnessDaysShort", Math.Max(1, (int)age.TotalDays));
        }
    }

    private string ConfidencePercent =>
        _result?.Recognition.Confidence is float confidence ? confidence.ToString("P0") : string.Empty;

    private string DisplayName =>
        _result?.Item.Name
        ?? _result?.Item.ShortName
        ?? Localizer["UnknownItem"];

    private string FriendlyItemType => ItemTypeLabel.Format(_result?.Item.ItemType);

    private string SelectionMethodLabel =>
        IsManual
            ? Localizer["SelectedManually"]
            : _result?.Recognition.Confidence is float confidence
                ? Localizer.Format("AutomaticScanWithConfidence", confidence.ToString("P0"))
                : Localizer["AutomaticScan"];

    private string SelectionMethodDetail =>
        IsManual ? Localizer["SelectedManually"] : Localizer["AutomaticScan"];

    private string ScanConfidenceDetail =>
        IsManual
            ? Localizer["NotApplicable"]
            : _result?.Recognition.Confidence is float confidence
                ? $"{confidence:P0}"
                : _result?.Recognition.Label ?? Localizer["Unavailable"];

    private string ExactUpdatedText =>
        _result?.Pricing.UpdatedAt is DateTimeOffset updated
            ? updated.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
            : Localizer["Unknown"];

    private string VerdictWord =>
        _result?.Recommendation.Type switch
        {
            RecommendationType.KeepForQuest or RecommendationType.KeepForHideout => Localizer["VerdictKeep"],
            RecommendationType.QuestAvailableSoon => Localizer["VerdictNeededSoon"],
            RecommendationType.NeededLater => Localizer["VerdictNeededLater"],
            RecommendationType.MaybeNeeded => Localizer["VerdictMaybeNeeded"],
            RecommendationType.SellOnFlea or RecommendationType.SellToTrader => Localizer["VerdictSell"],
            _ => Localizer["VerdictCheck"],
        };

    private string VerdictReason
    {
        get
        {
            if (_result is null)
                return string.Empty;

            string traderName = _result.Trader?.Name ?? Localizer["TraderLabel"];
            return _result.Recommendation.Type switch
            {
                RecommendationType.KeepForQuest or RecommendationType.QuestAvailableSoon
                or RecommendationType.NeededLater or RecommendationType.MaybeNeeded =>
                    _result.Recommendation.Explanation,
                RecommendationType.KeepForHideout =>
                    Localizer.Format("HideoutRequirementSummary", _result.Hideout.RemainingRequired ?? 0),
                RecommendationType.SellOnFlea when Difference is > 0 =>
                    $"+{PriceFormatter.Format(Difference)} {Localizer.Format("VsTrader", traderName)}",
                RecommendationType.SellOnFlea =>
                    _result.Recommendation.Explanation,
                RecommendationType.SellToTrader when Difference is < 0 =>
                    $"+{PriceFormatter.Format(-Difference.Value)} {Localizer.Format("VsTrader", Localizer["FleaMarket"])}",
                RecommendationType.SellToTrader when Difference is 0 =>
                    Localizer["FleaAndTraderMatch"],
                RecommendationType.SellToTrader =>
                    _result.Recommendation.Explanation,
                _ => _result.Recommendation.Explanation,
            };
        }
    }

    private string VerdictTone =>
        _result?.Recommendation.Type switch
        {
            RecommendationType.KeepForQuest or RecommendationType.KeepForHideout => "tone-keep",
            RecommendationType.QuestAvailableSoon => "tone-accent",
            RecommendationType.MaybeNeeded or RecommendationType.PriceUnavailable => "tone-warning",
            _ => "tone-sell",
        };

    // Recent scans are scan-time snapshots kept in a DI singleton, so they
    // survive navigation without retaining screenshots or decoded images.
    private IReadOnlyList<ScanResultViewModel> RecentScans => RecentScansStore.Items;

    protected override void OnInitialized()
    {
        RefreshResult();
        MenuVM.PropertyChanged += OnResultChanged;
        RecentScansStore.Changed += OnRecentScansChanged;
    }

    private void RefreshResult()
    {
        _result = MenuVM.LastItemScan.IsSeed ? null : ScanResultAdapter.Map(MenuVM);
        _detailsOpen = false;
        _copiedId = false;
    }

    private async void OnResultChanged(object? sender, PropertyChangedEventArgs e) =>
        await InvokeAsync(() =>
        {
            RefreshResult();
            StateHasChanged();
        });

    private async void OnRecentScansChanged(object? sender, EventArgs e) =>
        await InvokeAsync(StateHasChanged);

    private void SelectRecent(ScanResultViewModel scan)
    {
        _result = scan;
        _detailsOpen = false;
        _copiedId = false;
    }

    private System.Threading.Tasks.Task<IEnumerable<Item>> SearchItems(string value, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();

        string locale = RatConfig.NameScan.Language.ToTarkovDevLocale();
        TarkovDev.GameMode gameMode = RatConfig.GameMode;
        if (
            _items is null
            || _items.Count == 0
            || !string.Equals(_itemsLocale, locale, StringComparison.Ordinal)
            || _itemsGameMode != gameMode
        )
        {
            List<Item> available = TarkovDevAPI.GetItems().ToList();
            if (available.Count > 0)
            {
                _items = available;
                _itemsLocale = locale;
                _itemsGameMode = gameMode;
            }
        }

        return System.Threading.Tasks.Task.FromResult(
            (_items ?? [])
                .Where(i =>
                    string.IsNullOrWhiteSpace(value)
                    || (i.Name?.Contains(value, StringComparison.CurrentCultureIgnoreCase) ?? false)
                    || (i.ShortName?.Contains(value, StringComparison.CurrentCultureIgnoreCase) ?? false)
                )
                .Take(8)
        );
    }

    private void SelectItem(Item? item)
    {
        if (item is not null)
            MenuVM.ItemScans.Enqueue(new DefaultItemScan(item));
    }

    private void ToggleDetails()
    {
        _detailsOpen = !_detailsOpen;
        if (!_detailsOpen)
            _copiedId = false;
    }

    private async System.Threading.Tasks.Task FocusSearch()
    {
        if (_search is not null)
            await _search.FocusAsync();
    }

    private void CopyItemId()
    {
        if (string.IsNullOrWhiteSpace(_result?.Item.Id))
            return;

        try
        {
            System.Windows.Clipboard.SetText(_result.Item.Id);
            _copiedId = true;
        }
        catch
        {
            // Clipboard access can fail if the host window is not focused.
            _copiedId = false;
        }
    }

    private static bool IsRequired(RequirementViewModel? value) =>
        value?.Status == RequirementStatus.Required;

    /// <summary>
    /// Multi-line FIR tooltip: the title plus a per-bucket breakdown so a
    /// conditional FIR need never reads as a definite active one.
    /// </summary>
    private string FirTooltipText
    {
        get
        {
            if (_result is null)
                return string.Empty;

            QuestNeedReport report = _result.Quests.Report;
            List<string> lines = [Localizer["FirBadgeTitle"]];
            if (report.ActiveNowFir > 0)
                lines.Add(Localizer.Format("FirBreakdownActive", report.ActiveNowFir));
            if (report.AvailableNowFir > 0)
                lines.Add(Localizer.Format("FirBreakdownAvailable", report.AvailableNowFir));
            if (report.FutureKnownFir > 0)
                lines.Add(Localizer.Format("FirBreakdownFuture", report.FutureKnownFir));
            if (report.ConditionalUnknownFir > 0)
                lines.Add(Localizer.Format("FirBreakdownConditional", report.ConditionalUnknownFir));
            if (_result.Hideout.RequiresFoundInRaid > 0)
                lines.Add(Localizer.Format("FirBreakdownHideout", _result.Hideout.RequiresFoundInRaid));
            return lines.Count == 1 ? lines[0] : string.Join('\n', lines);
        }
    }

    private string HideoutChipTooltip =>
        _result is null ? string.Empty : Localizer.Format("RecHideoutRequiredFull", _result.Hideout.RemainingRequired ?? 0);

    private static string ShortLabel(string? shortName, string? name)
    {
        string label = !string.IsNullOrWhiteSpace(shortName) ? shortName : name ?? string.Empty;
        return label.Length <= 8 ? label : label[..8];
    }

    private void OpenMarket() => OpenUrl(_result?.Item.MarketUrl);
    private void OpenWiki() => OpenUrl(_result?.Item.WikiUrl);

    private static void OpenUrl(string? url) => ExternalLinkLauncher.Open(url);

    protected override async System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _fitRef = DotNetObjectReference.Create(this);
            try
            {
                // Best-effort: the fit watch must never break the page if the
                // host script is not loaded yet or interop is unavailable.
                await JSRuntime.InvokeVoidAsync("RatScanner.fitWatch.start", _fitRef);
            }
            catch (Exception exception) when (IsExpectedInteropShutdown(exception))
            {
            }
        }
    }

    /// <summary>
    /// JS fit watch callback: forwards the scan page's required content height to the
    /// host so the window can grow instead of clipping content behind a scrollbar.
    /// </summary>
    [JSInvokable]
    public void OnContentFitChanged(double requiredCssHeight, double visibleCssHeight)
    {
        if (!_disposed)
            AppState.ReportContentFit(requiredCssHeight, visibleCssHeight);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        MenuVM.PropertyChanged -= OnResultChanged;
        RecentScansStore.Changed -= OnRecentScansChanged;
        try
        {
            await JSRuntime.InvokeVoidAsync("RatScanner.fitWatch.stop");
        }
        catch (Exception exception) when (IsExpectedInteropShutdown(exception))
        {
        }

        AppState.ClearContentFit();
        _fitRef?.Dispose();
        _fitRef = null;
    }

    private static bool IsExpectedInteropShutdown(Exception exception) =>
        exception is JSException or JSDisconnectedException or ObjectDisposedException or TaskCanceledException;
}
