@page "/"
@page "/app"
@using RatScanner.Presentation
@using RatScanner.Scan
@using RatScanner.TarkovDev.GraphQL
@using System.Diagnostics
@using System.ComponentModel
@inject MenuVM MenuVM
@inject SessionHistoryService History
@inject NavigationManager Navigation
@implements IDisposable

<div class="scan-page">
    <div class="utility-bar">
        <div class="search"><MudAutocomplete @ref="_search" T="Item" Placeholder="Search items" SearchFunc="SearchItems" ValueChanged="SelectItem" ToStringFunc="@(item => item?.Name ?? string.Empty)" MaxItems="8" Dense="true" Clearable="true" ResetValueOnEmptyText="true" AdornmentIcon="@Icons.Material.Filled.Search"><ItemTemplate Context="item"><div class="search-result"><img src="@item.IconLink" alt="" /><span>@item.Name<small>@item.ShortName</small></span></div></ItemTemplate><NoItemsTemplate><div class="search-empty">No matching items found.</div></NoItemsTemplate></MudAutocomplete></div>
        <button class="history-button" title="View scan history" aria-label="View scan history" @onclick="OpenHistory"><MudIcon Icon="@Icons.Material.Filled.History" /></button>
    </div>

    @if (_recent.Count > 0) { <section class="recent" aria-label="Recent scans"><span>Recent scans</span>@foreach (ItemScan scan in _recent) { <button class="thumb @(_result?.Item.Id == scan.Item.Id ? "selected" : null)" title="@scan.Item.Name" @onclick="() => SelectRecent(scan)"><img src="@scan.Item.IconLink" alt="" /></button> }</section> }
    @if (_result is null) {
    <section class="empty-state" aria-live="polite">
        <MudIcon Icon="@Icons.Material.Filled.CenterFocusWeak" />
        <div><strong>Ready to scan</strong><span>Inspect or click an item in Escape from Tarkov, or search above.</span></div>
    </section>
    } else {
    @if (!IsScannerActive) { <section class="state-banner"><strong>Scanner paused</strong><span>Enable name or icon scanning in Settings to resume.</span></section> }
    @if (_result.Recognition.Confidence is < .7f) { <section class="state-banner warning"><strong>This match may be incorrect.</strong><span>Search for a different item if the detected result is wrong.</span></section> }
    <article class="result-card" aria-live="polite" aria-label="Current scan result">
        <section class="identity"><div class="item-art"><img src="@_result.Item.ImageUrl" alt="@_result.Item.Name" /><small>x@_result.Item.Quantity</small></div><div><h1>@(_result.Item.Name ?? "Unknown item")</h1>@if (!string.IsNullOrWhiteSpace(_result.Item.ShortName) && _result.Item.ShortName != _result.Item.Name) { <h2>@_result.Item.ShortName</h2> }<p><MudIcon Icon="@Icons.Material.Filled.Category" /> @(_result.Item.ItemType ?? "Item")</p></div></section>

        <section class="recommendation-panel">
            <div><label>Recommended action</label><h2>@_result.Recommendation.Title</h2><p>@_result.Recommendation.Explanation</p></div>
            <div class="market-price"><label>Flea market price</label><strong>@PriceFormatter.Format(_result.Pricing.FleaPrice)</strong><p>@PriceFormatter.Format(_result.Pricing.FleaPricePerSlot) per slot</p><small><i></i> @_result.Pricing.SourceName · @FreshnessFormatter.Format(_result.Pricing.UpdatedAt)</small></div>
        </section>

        <div class="actions"><button class="primary" @onclick="OpenMarket" disabled="@string.IsNullOrWhiteSpace(_result.Item.MarketUrl)">Open on Tarkov.dev <MudIcon Icon="@Icons.Material.Filled.OpenInNew" /></button><button @onclick="OpenWiki" disabled="@string.IsNullOrWhiteSpace(_result.Item.WikiUrl)">Open wiki <MudIcon Icon="@Icons.Material.Filled.OpenInNew" /></button></div>

        <section class="comparison"><div><label>Best trader</label><strong>@(_result.Trader?.Name ?? "Unavailable")</strong><span>@PriceFormatter.Format(_result.Trader?.TotalPrice)</span></div><div><label>Market difference</label><strong class="@DifferenceClass">@FormatDifference()</strong><span>Flea minus trader value</span></div><div><label>Trader value</label><strong>@PriceFormatter.Format(_result.Trader?.TotalPrice)</strong><span>@PriceFormatter.Format(_result.Trader?.PricePerSlot) per slot</span></div></section>

        <section class="requirements"><div><label>Quests</label><strong>@RequirementTitle(_result.Quests)</strong><p>@RequirementDescription(_result.Quests, "active quests")</p></div><div><label>Hideout</label><strong>@RequirementTitle(_result.Hideout)</strong><p>@RequirementDescription(_result.Hideout, "hideout upgrades")</p></div></section>

        <section class="metadata"><div><label>Scan confidence</label><strong class="@ConfidenceClass"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /> @_result.Recognition.Label @if (_result.Recognition.Confidence is float confidence) { <span>@confidence.ToString("P0")</span> }</strong></div><div><label>Item type</label><strong>@(_result.Item.ItemType ?? "Unavailable")</strong></div><div><label>Size</label><strong>@_result.Item.SlotCount @(_result.Item.SlotCount == 1 ? "slot" : "slots")</strong></div></section>
        <p class="disclaimer"><MudIcon Icon="@Icons.Material.Filled.Info" /> Prices may change. Verify the current market price before selling.</p>
    </article>
    }
</div>

@code {
    private ScanResultViewModel? _result;
    private List<Item>? _items;
    private readonly List<ItemScan> _recent = new();
    private MudAutocomplete<Item>? _search;
    private string ConfidenceClass => _result?.Recognition.Confidence >= .7f ? "positive" : string.Empty;
    private string DifferenceClass => Difference is > 0 ? "positive" : string.Empty;
    private int? Difference => _result?.Pricing.FleaPrice is int flea && _result.Trader?.TotalPrice is int trader ? flea - trader : null;
    private bool IsScannerActive => RatConfig.NameScan.Enable || RatConfig.IconScan.Enable;

    protected override void OnInitialized() { RefreshResult(); if (History.Selected is not null) { _result = History.Selected; History.Selected = null; } if (!MenuVM.LastItemScan.IsSeed) AddRecent(MenuVM.LastItemScan); MenuVM.PropertyChanged += OnResultChanged; }
    private void RefreshResult() => _result = MenuVM.LastItemScan.IsSeed ? null : ScanResultAdapter.Map(MenuVM);
    private async void OnResultChanged(object? sender, PropertyChangedEventArgs e) => await InvokeAsync(() => { RefreshResult(); if (!MenuVM.LastItemScan.IsSeed) AddRecent(MenuVM.LastItemScan); StateHasChanged(); });
    private void AddRecent(ItemScan scan) { if (scan.IsSeed) return; _recent.RemoveAll(existing => existing.Item.Id == scan.Item.Id); _recent.Insert(0, scan); if (_recent.Count > 6) _recent.RemoveRange(6, _recent.Count - 6); }
    private void SelectRecent(ItemScan scan) => _result = ScanResultAdapter.Map(scan, MenuVM, true);
    private System.Threading.Tasks.Task<IEnumerable<Item>> SearchItems(string value) { if (_items is null || _items.Count == 0) { List<Item> available = TarkovDevAPI.GetItems().ToList(); if (available.Count > 0) _items = available; } return System.Threading.Tasks.Task.FromResult((_items ?? []).Where(i => string.IsNullOrWhiteSpace(value) || (i.Name?.Contains(value, StringComparison.CurrentCultureIgnoreCase) ?? false) || (i.ShortName?.Contains(value, StringComparison.CurrentCultureIgnoreCase) ?? false)).Take(8)); }
    private void SelectItem(Item item) { if (item is not null) MenuVM.ItemScans.Enqueue(new DefaultItemScan(item)); }
    private string FormatDifference() => Difference is int value ? $"{(value > 0 ? "+" : string.Empty)}{value:N0} ₽" : "Unavailable";
    private static string RequirementTitle(RequirementViewModel value) => value.Status == RequirementStatus.Required ? $"Needed: {value.RemainingRequired}" : value.Status == RequirementStatus.NotRequired ? "Not required" : "Unavailable";
    private static string RequirementDescription(RequirementViewModel value, string subject) => value.Status == RequirementStatus.Required ? $"{value.RemainingRequired} still required for {subject}." : value.Status == RequirementStatus.NotRequired ? $"Not needed for any {subject}." : "Progress data unavailable.";
    private void OpenMarket() => OpenUrl(_result?.Item.MarketUrl);
    private void OpenHistory() => Navigation.NavigateTo("/app/history");
    private void OpenWiki() => OpenUrl(_result?.Item.WikiUrl);
    private static void OpenUrl(string? url) { if (!string.IsNullOrWhiteSpace(url)) Process.Start(new ProcessStartInfo(url) { UseShellExecute = true }); }
    public void Dispose() => MenuVM.PropertyChanged -= OnResultChanged;
}
