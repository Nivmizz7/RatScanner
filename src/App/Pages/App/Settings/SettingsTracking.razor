@page "/app/settings/tracking"
@using System.Linq
@using System.Threading
@using RatScanner.Components
@using RatScanner.Runtime
@using GameMode = RatScanner.TarkovDev.GameMode
@inject SettingsVM SettingsVM
@inject LocalizationService Localizer
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ITrackerService TrackerService
@implements IDisposable

<div class="settings-page tracking-settings">
    <section class="settings-section">
        <header class="section-heading">
            <div>
                <h2>@Localizer["TrackingDisplaySection"]</h2>
                <p>@Localizer["TrackingDisplayDescription"]</p>
            </div>
        </header>
        <ImmediateSettingSwitch Value="@RatConfig.Tracking.ShowNonFIRNeeds"
                                ValueChanged="@(_ => StateHasChanged())"
                                Label="@Localizer["ShowNonFirNeeds"]"
                                Persist="SettingsVM.SetShowNonFirNeedsAsync" />
        <ImmediateSettingSwitch Value="@RatConfig.Tracking.ShowKappaNeeds"
                                ValueChanged="@(_ => StateHasChanged())"
                                Label="@Localizer["ShowKappaNeeds"]"
                                Persist="SettingsVM.SetShowKappaNeedsAsync" />
        <ImmediateSettingSwitch Value="@RatConfig.Tracking.TarkovTracker.ShowTeam"
                                ValueChanged="@(_ => StateHasChanged())"
                                Label="@Localizer["ShowTeammates"]"
                                Persist="SettingsVM.SetShowTarkovTrackerTeamAsync" />
        <p class="section-description">@Localizer["TeamPermissionDescription"]</p>
    </section>

    <section class="settings-section">
        <header class="section-heading tracker-section-heading">
            <div>
                <h2>@Localizer["TarkovTrackerSection"]</h2>
                <p>@Localizer["TarkovTrackerIntro"]</p>
            </div>
            <MudLink Href="@Constants.Links.TarkovTracker"
                     Target="_blank"
                     Typo="Typo.body2"
                     Class="tracker-section-manage-link">
                @Localizer["ManageApiKeys"]
            </MudLink>
        </header>

        @foreach (GameMode mode in Modes)
        {
            <div class="tracker-mode">
                <div class="tracker-mode-heading">
                    <div class="tracker-mode-title">
                        <h3>@ModeLabel(mode)</h3>
                    </div>
                    <span class="@StatusClass(_state[mode]) tracker-mode-status">@StatusLabel(_state[mode])</span>
                    @if (IsModeConfigured(mode))
                    {
                        <MudTooltip Text="@Localizer.Format("ManageConnection", ModeLabel(mode))" Placement="Placement.Bottom" RootClass="tracker-overflow-tooltip">
                            <ChildContent>
                                <MudMenu AriaLabel="@Localizer["TrackerOverflowMenu"]"
                                         Open="@_menuOpen[mode]"
                                         OpenChanged="@(value => _menuOpen[mode] = value)"
                                         Variant="Variant.Text"
                                         Size="Size.Small"
                                         Color="Color.Default"
                                         Icon="@Icons.Material.Filled.MoreVert"
                                         Class="tracker-overflow">
                                    <ChildContent>
                                        <MudMenuItem OnClick="@(() => HandleMenuActionAsync(mode, "change"))" Icon="@Icons.Material.Filled.SwapHoriz">
                                            @Localizer["ChangeConnection"]
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="@(() => HandleMenuActionAsync(mode, "disconnect"))" Icon="@Icons.Material.Filled.LinkOff" IconColor="Color.Error">
                                            @Localizer["Disconnect"]
                                        </MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </ChildContent>
                        </MudTooltip>
                    }
                </div>

                @if (!IsModeConfigured(mode))
                {
                    <div class="token-row">
                        <MudTextField T="string"
                                      Value="@_draft[mode]"
                                      ValueChanged="@(value => _draft[mode] = value ?? "")"
                                      Label="@Localizer["ApiToken"]"
                                      InputType="@(_visible[mode] ? InputType.Text : InputType.Password)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Disabled="@_testing[mode]"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_visible[mode] ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentAriaLabel="@(_visible[mode] ? Localizer["HideApiKey"] : Localizer["ShowApiKey"])"
                                      OnAdornmentClick="@(() => _visible[mode] = !_visible[mode])"
                                      OnKeyDown="@(args => HandleKeyDownAsync(mode, args))" />
                        <div class="credential-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Disabled="@(!CanConnect(mode))"
                                       OnClick="@(() => ConnectAsync(mode))">
                                @if (_testing[mode])
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                @(_testing[mode] ? Localizer["Connecting"] : Localizer["Connect"])
                            </MudButton>
                        </div>
                    </div>
                    @if (_error[mode] is not null)
                    {
                        <p class="inline-error" role="alert">@_error[mode]</p>
                    }
                }
            </div>

            @if (mode != Modes[^1])
            {
                <hr class="tracker-divider" />
            }
        }
    </section>
</div>

@code {
    private static readonly GameMode[] Modes = [GameMode.Regular, GameMode.Pve, GameMode.Seasonal];
    private readonly Dictionary<GameMode, string> _draft = Modes.ToDictionary(mode => mode, _ => "");
    private readonly Dictionary<GameMode, string?> _error = Modes.ToDictionary(mode => mode, _ => (string?)null);
    private readonly Dictionary<GameMode, bool> _testing = Modes.ToDictionary(mode => mode, _ => false);
    private readonly Dictionary<GameMode, bool> _visible = Modes.ToDictionary(mode => mode, _ => false);
    private readonly Dictionary<GameMode, TrackerConnectionState> _state = Modes.ToDictionary(
        mode => mode,
        mode => IsModeConfigured(mode) ? TrackerConnectionState.Untested : TrackerConnectionState.NotConfigured
    );
    private readonly Dictionary<GameMode, CancellationTokenSource?> _validation = Modes.ToDictionary(
        mode => mode,
        _ => (CancellationTokenSource?)null
    );
    private readonly Dictionary<GameMode, bool> _menuOpen = Modes.ToDictionary(mode => mode, _ => false);

    protected override void OnInitialized()
    {
        GameMode mode = RatConfig.GameMode;
        TrackerStateSnapshot trackerState = TrackerService.State;
        if (
            IsModeConfigured(mode)
            && string.Equals(
                trackerState.Token,
                RatConfig.Tracking.TarkovTracker.TokenForMode(mode),
                StringComparison.Ordinal
            )
        )
        {
            _state[mode] = trackerState.ConnectionState;
        }
    }

    private static bool IsModeConfigured(GameMode mode) =>
        !string.IsNullOrWhiteSpace(RatConfig.Tracking.TarkovTracker.TokenForMode(mode));

    private bool CanConnect(GameMode mode) =>
        !_testing[mode] && !string.IsNullOrWhiteSpace(_draft[mode]);

    private string ModeLabel(GameMode mode) => GameModeDisplay.GetLabel(mode, Localizer);

    private string StatusLabel(TrackerConnectionState state) => state switch
    {
        TrackerConnectionState.NotConfigured => Localizer["IntegrationNotConfigured"],
        TrackerConnectionState.Untested => Localizer["IntegrationUntested"],
        TrackerConnectionState.Testing => Localizer["IntegrationTesting"],
        TrackerConnectionState.Connected => Localizer["IntegrationConnected"],
        TrackerConnectionState.MissingPermissions => Localizer["IntegrationMissingPermissions"],
        TrackerConnectionState.InvalidKey => Localizer["IntegrationInvalidKey"],
        _ => Localizer["IntegrationConnectionError"],
    };

    private static string StatusClass(TrackerConnectionState state) => state switch
    {
        TrackerConnectionState.Connected => "credential-status status-success",
        TrackerConnectionState.MissingPermissions => "credential-status status-warning",
        TrackerConnectionState.InvalidKey => "credential-status status-error",
        TrackerConnectionState.ConnectionError => "credential-status status-warning",
        _ => "credential-status status-info",
    };

    private async Task HandleKeyDownAsync(GameMode mode, KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ConnectAsync(mode);
    }

    private async Task ConnectAsync(GameMode mode)
    {
        string candidate = _draft[mode].Trim();
        if (string.IsNullOrWhiteSpace(candidate) || _testing[mode])
            return;

        _validation[mode]?.Cancel();
        _validation[mode]?.Dispose();
        CancellationTokenSource cancellation = new();
        _validation[mode] = cancellation;
        string previousToken = RatConfig.Tracking.TarkovTracker.TokenForMode(mode);
        _testing[mode] = true;
        _state[mode] = TrackerConnectionState.Testing;
        _error[mode] = null;
        try
        {
            TrackerValidationResult result = await TrackerService.ValidateOrgKeyAsync(
                mode,
                candidate,
                cancellation.Token
            );
            cancellation.Token.ThrowIfCancellationRequested();
            if (!result.Succeeded)
            {
                _state[mode] = StateFor(result);
                _error[mode] = ValidationMessage(result, mode);
                return;
            }

            SettingSaveResult saved = await CredentialPersistenceCoordinator.PersistCandidateAsync(
                () => SettingsVM.SetTarkovTrackerOrgTokenAsync(mode, candidate),
                () => SettingsVM.SetTarkovTrackerOrgTokenAsync(mode, previousToken),
                cancellation.Token
            );
            if (!saved.Succeeded)
            {
                _error[mode] = Localizer["CredentialSaveFailed"];
                // The candidate never reached storage, so the stored key is still the
                // previous one and nothing verified it during this attempt. Report it
                // as unverified rather than claiming a connection was established.
                _state[mode] = IsModeConfigured(mode)
                    ? TrackerConnectionState.Untested
                    : TrackerConnectionState.NotConfigured;
                return;
            }

            if (RatConfig.GameMode == mode)
            {
                await TrackerService.ActivateModeAsync(mode, cancellation.Token);
                _state[mode] = TrackerService.State.ConnectionState;
            }
            else
            {
                _state[mode] = TrackerConnectionState.Connected;
            }
            _draft[mode] = "";
            _visible[mode] = false;
            _error[mode] = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (_validation[mode] == cancellation)
            {
                if (_state[mode] == TrackerConnectionState.Testing)
                    _state[mode] = IsModeConfigured(mode)
                        ? TrackerConnectionState.Untested
                        : TrackerConnectionState.NotConfigured;
                _testing[mode] = false;
                _validation[mode] = null;
                cancellation.Dispose();
            }
        }
    }

    private async Task RemoveKeyAsync(GameMode mode)
    {
        SettingSaveResult result = await SettingsVM.SetTarkovTrackerOrgTokenAsync(mode, "");
        if (!result.Succeeded)
        {
            Snackbar.Add(Localizer["CredentialRemoveFailed"], Severity.Error);
            return;
        }

        _state[mode] = TrackerConnectionState.NotConfigured;
        if (RatConfig.GameMode == mode)
            await TrackerService.ActivateModeAsync(mode);
    }

    private async Task DisconnectWithConfirmAsync(GameMode mode)
    {
        DialogParameters<DisconnectConfirmDialog> disconnectParams = new()
        {
            { x => x.ModeLabel, ModeLabel(mode) }
        };
        DialogOptions disconnectOptions = new() { MaxWidth = MaxWidth.ExtraSmall, CloseButton = true };
        IDialogReference disconnectDialog = await DialogService.ShowAsync<DisconnectConfirmDialog>(
            Localizer.Format("DisconnectConfirmTitle", ModeLabel(mode)),
            disconnectParams,
            disconnectOptions
        );
        DialogResult? disconnectResult = await disconnectDialog.Result;
        if (disconnectResult is null || disconnectResult.Canceled)
            return;
        await RemoveKeyAsync(mode);
    }

    private async Task HandleMenuActionAsync(GameMode mode, string action)
    {
        _menuOpen[mode] = false;
        await Task.Yield();
        if (action == "change")
            await OpenChangeConnectionDialogAsync(mode);
        else
            await DisconnectWithConfirmAsync(mode);
    }

    private async Task OpenChangeConnectionDialogAsync(GameMode mode)
    {
        DialogParameters<ChangeConnectionDialog> changeParams = new()
        {
            { x => x.Mode, mode },
            { x => x.ModeLabel, ModeLabel(mode) },
        };
        DialogOptions changeOptions = new()
        {
            MaxWidth = MaxWidth.Small,
            CloseButton = true,
            BackgroundClass = "dialog-backdrop-light",
        };
        await JSRuntime.InvokeVoidAsync(
            "eval",
            "var el=document.querySelector('.main-content');if(el){el.style.overflow='hidden';}"
        );
        DialogResult? changeResult;
        try
        {
            IDialogReference changeDialog = await DialogService.ShowAsync<ChangeConnectionDialog>(
                Localizer.Format("ChangeConnectionTitle", ModeLabel(mode)),
                changeParams,
                changeOptions
            );
            changeResult = await changeDialog.Result;
        }
        finally
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "eval",
                    "var el=document.querySelector('.main-content');if(el){el.style.overflow='';}"
                );
            }
            catch (Exception exception)
            {
                Logger.LogWarning("Unable to restore page scroll after the change-connection dialog.", exception);
            }
        }
        if (changeResult is not null && !changeResult.Canceled)
        {
            _state[mode] = RatConfig.GameMode == mode
                ? TrackerService.State.ConnectionState
                : TrackerConnectionState.Connected;
        }
    }

    private static TrackerConnectionState StateFor(TrackerValidationResult result) => result.Failure switch
    {
        TrackerValidationFailure.InvalidKey or TrackerValidationFailure.WrongGameMode => TrackerConnectionState.InvalidKey,
        TrackerValidationFailure.MissingPermissions => TrackerConnectionState.MissingPermissions,
        _ => TrackerConnectionState.ConnectionError,
    };

    private string ValidationMessage(TrackerValidationResult result, GameMode mode) => result.Failure switch
    {
        TrackerValidationFailure.InvalidKey => Localizer["CredentialInvalid"],
        TrackerValidationFailure.WrongGameMode => Localizer.Format("CredentialWrongMode", ModeLabel(mode)),
        TrackerValidationFailure.MissingPermissions => result.MissingPermissions.Count > 0
            ? Localizer.Format("CredentialMissingPermissions", string.Join(", ", result.MissingPermissions))
            : Localizer["CredentialMissingPermissionGeneric"],
        TrackerValidationFailure.RateLimited => Localizer["CredentialRateLimited"],
        TrackerValidationFailure.ServiceUnavailable => Localizer["CredentialServiceUnavailable"],
        TrackerValidationFailure.Network => Localizer["CredentialNetworkError"],
        _ => Localizer["CredentialUnexpectedResponse"],
    };

    public void Dispose()
    {
        foreach (CancellationTokenSource? validation in _validation.Values)
        {
            validation?.Cancel();
            validation?.Dispose();
        }
    }
}
