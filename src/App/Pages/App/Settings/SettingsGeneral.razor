@page "/app/settings/general"
@layout SettingsLayout
@using RatScanner.Display
@using System.Globalization
@using System.Linq
@inject SettingsVM SettingsVM
@inject LocalizationService Localizer
@inject ISnackbar Snackbar
@implements IDisposable

<div class="settings-page">
    <div class="settings-column">
        <section class="settings-section">
            <header class="section-heading">
                <div>
                    <h2>@Localizer["GameDisplay"]</h2>
                    <p>@Localizer["GameDisplayDescription"]</p>
                </div>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="_refreshing"
                           OnClick="RefreshDisplayDetectionAsync">
                    @Localizer["RefreshDetection"]
                </MudButton>
            </header>

            <MudSelect T="string"
                       Value="@SettingsVM.SelectedGameDisplayId"
                       ValueChanged="SetDisplayAsync"
                       Label="@Localizer["GameDisplay"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       FullWidth="true"
                       Disabled="@(SettingsVM.GameDisplayOptions.Count == 0 || _savingDisplay)"
                       Error="@(SettingsVM.DisplaySelectionError is not null)"
                       ErrorText="@SettingsVM.DisplaySelectionError">
                @foreach (SettingsVM.GameDisplayOption option in SettingsVM.GameDisplayOptions)
                {
                    <MudSelectItem T="string" Value="@option.Id">@option.Label</MudSelectItem>
                }
            </MudSelect>

            <MudAlert Severity="@GetDisplaySeverity()" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                @SettingsVM.GameDisplayStatus
            </MudAlert>

            <details class="detected-details mt-3">
                <summary>@Localizer["DetectedConfiguration"]</summary>
                <dl class="configuration-grid">
                    <div><dt>@Localizer["PhysicalDisplayResolution"]</dt><dd>@SettingsVM.PhysicalDisplayResolution</dd></div>
                    <div><dt>@Localizer["LogicalDisplayResolution"]</dt><dd>@SettingsVM.LogicalDisplayResolution</dd></div>
                    <div><dt>@Localizer["GameViewport"]</dt><dd>@SettingsVM.GameViewportResolution</dd></div>
                    <div><dt>@Localizer["DisplayScaling"]</dt><dd>@SettingsVM.DisplayScaling</dd></div>
                    <div><dt>@Localizer["CaptureRegion"]</dt><dd>@SettingsVM.CaptureRegion</dd></div>
                    <div><dt>@Localizer["ModeLabel"]</dt><dd>@SettingsVM.DisplayDetectionMode</dd></div>
                </dl>
            </details>

            <details class="advanced-capture mt-3">
                <summary>@Localizer["AdvancedCapture"]</summary>
                <p class="section-description">@Localizer["UseCustomGameResolutionDescription"]</p>

                <div class="mt-3">
                    <ImmediateSettingSwitch Value="@SettingsVM.UseCustomGameResolution"
                                            ValueChanged="@(value => SettingsVM.UseCustomGameResolution = value)"
                                            Label="@Localizer["UseCustomGameResolution"]"
                                            Persist="PersistCustomResolutionToggleAsync" />
                </div>

                @if (SettingsVM.UseCustomGameResolution)
                {
                    <div class="capture-fields mt-3">
                        <MudTextField T="string"
                                      @bind-Value="SettingsVM.CustomGameWidthText"
                                      Label="@Localizer["GameViewportWidth"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputMode="InputMode.numeric"
                                      Immediate="true"
                                      OnBlur="PersistDisplayAsync"
                                      OnKeyDown="HandleDisplayKeyAsync"
                                      Error="@(SettingsVM.CustomResolutionError is not null)"
                                      ErrorText="@SettingsVM.CustomResolutionError" />
                        <MudTextField T="string"
                                      @bind-Value="SettingsVM.CustomGameHeightText"
                                      Label="@Localizer["GameViewportHeight"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputMode="InputMode.numeric"
                                      Immediate="true"
                                      OnBlur="PersistDisplayAsync"
                                      OnKeyDown="HandleDisplayKeyAsync"
                                      Error="@(SettingsVM.CustomResolutionError is not null)"
                                      ErrorText="@SettingsVM.CustomResolutionError" />
                    </div>

                    <div class="resolution-presets mt-2" aria-label="@Localizer["CommonResolutions"]">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetCustomResolutionAsync(1920, 1080))">1920 × 1080</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetCustomResolutionAsync(2560, 1440))">2560 × 1440</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetCustomResolutionAsync(3840, 2160))">3840 × 2160</MudButton>
                    </div>

                    <div class="mt-3">
                        <ImmediateSettingSwitch Value="@SettingsVM.UseCustomDisplayScale"
                                                ValueChanged="@(value => SettingsVM.UseCustomDisplayScale = value)"
                                                Label="@Localizer["OverrideDisplayScaling"]"
                                                Persist="PersistCustomScaleToggleAsync" />
                    </div>
                    @if (SettingsVM.UseCustomDisplayScale)
                    {
                        <MudTextField T="string"
                                      @bind-Value="SettingsVM.CustomDisplayScaleText"
                                      Label="@Localizer["DisplayScaling"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      InputMode="@DecimalInputMode"
                                      Adornment="Adornment.End"
                                      AdornmentText="%"
                                      OnBlur="PersistDisplayAsync"
                                      OnKeyDown="HandleDisplayKeyAsync"
                                      Error="@(SettingsVM.CustomDisplayScaleError is not null)"
                                      ErrorText="@SettingsVM.CustomDisplayScaleError"
                                      Class="mt-2" />
                    }
                }

                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Restore"
                           OnClick="ResetDisplayAsync"
                           Class="mt-3">
                    @Localizer["ResetDetectedValues"]
                </MudButton>
                @if (SettingsVM.DisplayPersistenceError is not null)
                {
                    <p class="inline-error" role="alert">@SettingsVM.DisplayPersistenceError</p>
                }
            </details>
        </section>
    </div>

    <aside class="settings-column">
        <section class="settings-section">
            <header class="section-heading"><div><h2>@Localizer["ApplicationSection"]</h2></div></header>
            <div class="setting-row">
                <div class="setting-copy">
                    <div class="setting-label">@Localizer["InterfaceLanguage"]</div>
                    <p class="setting-description">@Localizer["InterfaceLanguageDescription"]</p>
                </div>
                <div class="setting-control">
                    <MudSelect T="UiLanguage"
                               Value="@RatConfig.UserInterface.Language"
                               ValueChanged="SetUiLanguageAsync"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               FullWidth="true">
                        @foreach (UiLanguage language in GetUiLanguages())
                        {
                            <MudSelectItem T="UiLanguage" Value="@language">@language.ToCultureName()</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>
            <div class="setting-row">
                <div class="setting-copy">
                    <div class="setting-label">@Localizer["TooltipDelay"]</div>
                    <p class="setting-description">@Localizer["TooltipDelayDescription"]</p>
                </div>
                <div class="setting-control">
                    <MudSelect T="int"
                               Value="@RatConfig.ToolTip.Duration"
                               ValueChanged="SetTooltipDelayAsync"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               FullWidth="true">
                        <MudSelectItem T="int" Value="0">@Localizer["TooltipInstant"]</MudSelectItem>
                        <MudSelectItem T="int" Value="500">@Localizer["TooltipShort"]</MudSelectItem>
                        <MudSelectItem T="int" Value="1500">@Localizer["TooltipNormal"]</MudSelectItem>
                        <MudSelectItem T="int" Value="3000">@Localizer["TooltipLong"]</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
            <ImmediateSettingSwitch Value="@RatConfig.AlwaysOnTop"
                                    ValueChanged="@(_ => StateHasChanged())"
                                    Label="@Localizer["AlwaysOnTop"]"
                                    Persist="SettingsVM.SetAlwaysOnTopAsync" />
        </section>

        <section class="settings-section">
            <header class="section-heading">
                <div>
                    <h2>@Localizer["DiagnosticsSection"]</h2>
                    <p>@Localizer["DiagnosticsDescription"]</p>
                </div>
            </header>
            <ImmediateSettingSwitch Value="@RatConfig.LogDebug"
                                    ValueChanged="@(_ => StateHasChanged())"
                                    Label="@Localizer["LogDebugInfo"]"
                                    Persist="SettingsVM.SetLogDebugAsync" />
        </section>
    </aside>
</div>

@code {
    private static InputMode DecimalInputMode => InputMode.@decimal;

    private bool _refreshing;
    private bool _savingDisplay;
    private int _displaySaveOperations;

    protected override void OnInitialized()
    {
        SettingsVM.PropertyChanged += PropertyChangeHandler;
        SettingsVM.RefreshGameDisplays();
    }

    private IEnumerable<UiLanguage> GetUiLanguages() =>
        Enum.GetValues<UiLanguage>().OrderBy(language => language.ToCultureName());

    private Severity GetDisplaySeverity() => SettingsVM.GameDisplayStatusKind switch
    {
        GameDisplayStatusKind.Success => Severity.Success,
        GameDisplayStatusKind.Warning => Severity.Warning,
        GameDisplayStatusKind.Error => Severity.Error,
        _ => Severity.Info,
    };

    private async Task RefreshDisplayDetectionAsync()
    {
        _refreshing = true;
        try
        {
            await SettingsVM.RefreshGameDisplaysAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task SetDisplayAsync(string value)
    {
        string previous = SettingsVM.SelectedGameDisplayId;
        SettingsVM.SelectedGameDisplayId = value;
        SettingSaveResult result = await PersistDisplayAsync();
        if (!result.Succeeded)
            SettingsVM.SelectedGameDisplayId = previous;
    }

    private async Task<SettingSaveResult> PersistCustomResolutionToggleAsync(bool value) => await PersistDisplayAsync();
    private async Task<SettingSaveResult> PersistCustomScaleToggleAsync(bool value) => await PersistDisplayAsync();

    private async Task<SettingSaveResult> PersistDisplayAsync()
    {
        _displaySaveOperations++;
        _savingDisplay = true;
        try
        {
            SettingSaveResult result = await SettingsVM.PersistDisplaySettingsAsync();
            if (!result.Succeeded && result.ErrorMessage is null)
                Snackbar.Add(Localizer["SettingSaveFailed"], Severity.Error);
            return result;
        }
        finally
        {
            _displaySaveOperations--;
            _savingDisplay = _displaySaveOperations > 0;
        }
    }

    private async Task HandleDisplayKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await PersistDisplayAsync();
        else if (args.Key == "Escape")
            SettingsVM.RefreshGameDisplays();
    }

    private async Task SetCustomResolutionAsync(int width, int height)
    {
        SettingsVM.CustomGameWidthText = width.ToString(CultureInfo.CurrentCulture);
        SettingsVM.CustomGameHeightText = height.ToString(CultureInfo.CurrentCulture);
        await PersistDisplayAsync();
    }

    private async Task ResetDisplayAsync()
    {
        SettingsVM.ResetDisplayDraftToDetected();
        await PersistDisplayAsync();
    }

    private async Task SetUiLanguageAsync(UiLanguage value)
    {
        SettingSaveResult result = await SettingsVM.SetUiLanguageAsync(value);
        if (!result.Succeeded)
            Snackbar.Add(Localizer["SettingSaveFailed"], Severity.Error);
    }

    private async Task SetTooltipDelayAsync(int value)
    {
        SettingSaveResult result = await SettingsVM.SetTooltipDurationAsync(value);
        if (!result.Succeeded)
            Snackbar.Add(Localizer["SettingSaveFailed"], Severity.Error);
    }

    private void PropertyChangeHandler(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SettingsVM.PropertyChanged -= PropertyChangeHandler;
    }
}
