@page "/app/credits"
@using System.Diagnostics
@inject MenuVM MenuVM
@inject LocalizationService Localizer

<div class="about-page">
    <header class="about-header">
        <MudText Typo="Typo.subtitle1">@Localizer["CreditsTitle"]</MudText>
    </header>

    @* Current build first *@
    <section class="about-card">
        <MudText Typo="Typo.subtitle2" Class="about-card-title">@Constants.Branding.Name</MudText>
        <MudText Typo="Typo.caption" Class="about-muted">@Constants.Branding.ForkLabel</MudText>
        <MudText Typo="Typo.body2" Class="about-body">@Localizer["CreditsMaintainedBy"]</MudText>
        <MudText Typo="Typo.caption" Class="about-muted">@MenuVM.VersionDisplay</MudText>
        <MudText Typo="Typo.caption" Class="about-modified">@Localizer["CreditsModifiedNotice"]</MudText>
    </section>

    <section class="about-card">
        <MudText Typo="Typo.subtitle2" Class="about-card-title">@Localizer["CreditsLinksTitle"]</MudText>
        <div class="about-btn-grid about-btn-grid-primary">
            <button type="button" class="about-btn about-btn-repo" @onclick="@(() => OpenURL(Constants.Links.GitHub))">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                <span>@Localizer["CreditsThisForkShort"]</span>
            </button>
            <button type="button" class="about-btn about-btn-discord" @onclick="@(() => OpenURL(Constants.Links.Discord))">
                <MudIcon Icon="@Icons.Custom.Brands.Discord" Size="Size.Small" />
                <span>Discord</span>
            </button>
            <button type="button" class="about-btn about-btn-site" @onclick="@(() => OpenURL(Constants.Links.TarkovTracker))">
                <span>TarkovTracker.org</span>
            </button>
            <button type="button" class="about-btn about-btn-faq" @onclick="@(() => OpenURL(Constants.Links.FAQ))">
                <span>FAQ</span>
            </button>
        </div>
    </section>

    <section class="about-card">
        <MudText Typo="Typo.subtitle2" Class="about-card-title">@Localizer["CreditsDataTitle"]</MudText>
        <MudText Typo="Typo.body2" Class="about-body">@Localizer["CreditsDataBody"]</MudText>
        <div class="about-btn-grid about-btn-grid-single">
            <button type="button" class="about-btn about-btn-data" @onclick="@(() => OpenURL(Constants.Links.TarkovDev))">
                <span>tarkov.dev</span>
            </button>
        </div>
    </section>

    @* Original attribution last *@
    <section class="about-card about-card-attribution">
        <MudText Typo="Typo.subtitle2" Class="about-card-title about-card-title-dim">@Localizer["CreditsOriginalTitle"]</MudText>
        <MudText Typo="Typo.body2" Class="about-body about-body-dim">@Localizer["CreditsOriginalBody"]</MudText>
        <div class="about-btn-grid about-btn-grid-secondary">
            <button type="button" class="about-btn about-btn-secondary" @onclick="@(() => OpenURL(Constants.Links.OriginalGitHub))">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                <span>@Localizer["CreditsOriginalRepo"]</span>
            </button>
            <button type="button" class="about-btn about-btn-secondary" @onclick="@(() => OpenURL(Constants.Links.OriginalAuthorGitHub))">
                <span>@Constants.Branding.OriginalAuthor</span>
            </button>
        </div>
        <MudText Typo="Typo.caption" Class="about-license">@Localizer["CreditsLicenseNote"]</MudText>
    </section>
</div>

@code {
    private static void OpenURL(string url)
    {
        Process.Start(new ProcessStartInfo
        {
            FileName = url,
            UseShellExecute = true,
        });
    }
}
